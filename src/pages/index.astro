---
// src/pages/index.astro
import Navbar from "../componentes/navbar.astro";
import Footer from "../componentes/footer.astro";
import SEO from "../componentes/seo.astro";
import CircuitBG from "../componentes/CircuitBG.astro";
import "../styles/global.css";

const title =
  "NeoTec Business Solutions — Tecnología real para negocios que quieren crecer";
const description =
  "NeoTec Business Solutions desarrolla software, puntos de venta, plataformas web, microwebs, estrategias digitales y soluciones tecnológicas para PYMES que necesitan operar, vender y crecer mejor.";

const icons = {
  software: `<svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" viewBox="0 0 24 24" fill="currentColor"><path d="M4 4h16a2 2 0 012 2v9a2 2 0 01-2 2h-6v2h3v2H7v-2h3v-2H4a2 2 0 01-2-2V6a2 2 0 012-2zm0 2v9h16V6H4z"/></svg>`,
  pos: `<svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" viewBox="0 0 24 24" fill="currentColor"><path d="M5 3h14a2 2 0 012 2v11H3V5a2 2 0 012-2zm1 3v8h12V6H6zm-3 12h18v1a2 2 0 01-2 2H5a2 2 0 01-2-2v-1zm5-10h2v2H8V8zm4 0h2v2h-2V8z"/></svg>`,
  web: `<svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" viewBox="0 0 24 24" fill="currentColor"><path d="M3 4h18a2 2 0 012 2v12a2 2 0 01-2 2H3a2 2 0 01-2-2V6a2 2 0 012-2zm0 4v10h18V8H3zm2-3v2h2V5H5zm4 0v2h2V5H9z"/></svg>`,
  social: `<svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" viewBox="0 0 24 24" fill="currentColor"><path d="M4 5h16a2 2 0 012 2v10a2 2 0 01-2 2H8l-5 3v-3H4a2 2 0 01-2-2V7a2 2 0 012-2zm3 4v2h10V9H7zm0 4v2h7v-2H7z"/></svg>`,
  hardware: `<svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" viewBox="0 0 24 24" fill="currentColor"><path d="M7 2h10v2h3v3h2v10h-2v3h-3v2H7v-2H4v-3H2V7h2V4h3V2zm0 6v8h10V8H7zm2 2h6v4H9v-4z"/></svg>`,
  strategy: `<svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l9 5v6c0 5-3.8 9.7-9 11-5.2-1.3-9-6-9-11V7l9-5zm0 4.2L7 9v4.2c0 2.9 2 5.8 5 6.8 3-1 5-3.9 5-6.8V9l-5-2.8zm-1 10.3l-3-3 1.4-1.4 1.6 1.6 4.6-4.6 1.4 1.4-6 6z"/></svg>`,
  check: `<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d="M9 16.2l-3.5-3.5L4 14.2l5 5 11-11-1.5-1.5z"/></svg>`,
  arrow: `<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d="M13 5l7 7-7 7v-4H4v-6h9V5z"/></svg>`,
  pulse: `<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 1010 10A10.011 10.011 0 0012 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/></svg>`,
};

const metrics = [
  {
    value: "2+",
    label: "clientes activos",
    detail: "en gestión de redes y presencia digital",
  },
  {
    value: "1",
    label: "plataforma grande",
    detail: "en desarrollo para operación digital",
  },
  {
    value: "1",
    label: "POS completo",
    detail: "en construcción para venta e inventario",
  },
  {
    value: "360°",
    label: "visión integral",
    detail: "software, web, hardware y estrategia",
  },
];

const solutions = [
  {
    title: "Software empresarial",
    description:
      "Sistemas administrativos, plataformas internas, automatización, CRM/ERP y herramientas hechas para operar con orden.",
    icon: icons.software,
  },
  {
    title: "Punto de venta",
    description:
      "POS completo para ventas, caja, inventario, productos, clientes, reportes y control operativo.",
    icon: icons.pos,
  },
  {
    title: "Webs y microwebs",
    description:
      "Sitios profesionales, landing pages, tarjetas digitales y presencia web optimizada para negocios locales.",
    icon: icons.web,
  },
  {
    title: "Redes sociales",
    description:
      "Gestión estratégica de contenido, campañas, comunicación visual y presencia digital para negocios reales.",
    icon: icons.social,
  },
  {
    title: "Hardware y soporte",
    description:
      "Asesoría, configuración, mantenimiento, implementación técnica y acompañamiento para infraestructura física.",
    icon: icons.hardware,
  },
  {
    title: "Consultoría tecnológica",
    description:
      "Diagnóstico de procesos, selección de herramientas, mejora operativa y digitalización escalable para PYMES.",
    icon: icons.strategy,
  },
];

const process = [
  {
    step: "01",
    title: "Diagnóstico",
    text: "Entendemos tu operación real: cómo vendes, cómo cobras, cómo registras, dónde pierdes tiempo y qué procesos duelen.",
  },
  {
    step: "02",
    title: "Diseño de solución",
    text: "Definimos qué necesita tu negocio: software, POS, web, redes, hardware, automatización o una mezcla bien armada.",
  },
  {
    step: "03",
    title: "Implementación",
    text: "Construimos, configuramos, desplegamos y ajustamos con enfoque práctico. Nada de soluciones bonitas que nadie usa.",
  },
  {
    step: "04",
    title: "Acompañamiento",
    text: "Capacitamos, damos soporte y evolucionamos la solución conforme tu negocio crece o cambia de ritmo.",
  },
];

const proof = [
  "Gestión de redes sociales para negocios locales.",
  "Desarrollo de una plataforma digital de alto alcance.",
  "Construcción de un punto de venta completo.",
  "Microwebs profesionales para marcas, servicios y despachos.",
  "Soluciones pensadas para PYMES mexicanas, no para organigramas imaginarios.",
];
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <SEO
      title={title}
      description={description}
      type="website"
      locale="es_MX"
      url="https://tecno.vercel.app/"
      siteName="NeoTec Business Solutions"
      ogImage="/og-default.png"
      logo="/web-app-manifest-512x512.png"
      phone="+52 443 371 1589"
      email="contacto@tecno.mx"
      address={{
        streetAddress: "Morelia",
        addressLocality: "Morelia",
        addressRegion: "Michoacán",
        addressCountry: "MX",
      }}
    />
    <title>{title}</title>
  </head>

  <body
    class="min-h-screen overflow-x-hidden bg-slate-950 text-slate-100 selection:bg-cyan-400/30 selection:text-white"
  >
    <CircuitBG
      background="#030712"
      primary="#1a9cff"
      accent="#6ad8ff"
      glow="#e8fbff"
      opacity={0.58}
      speed={18}
      showGrid={true}
      showScanlines={true}
      showParticles={true}
    />

    <Navbar />

    <main class="relative z-10">
      <!-- HERO -->
      <section
        class="relative min-h-[100svh] overflow-hidden px-4 pt-28 pb-14 sm:px-6 sm:pt-32 lg:px-8"
      >
        <div
          class="mx-auto flex min-h-[calc(100svh-8rem)] max-w-[1440px] items-center"
        >
          <div
            class="grid w-full gap-12 lg:grid-cols-[1.1fr_0.9fr] lg:items-center"
          >
            <div class="reveal space-y-7">
              <div
                class="inline-flex items-center gap-2 rounded-full border border-cyan-300/25 bg-cyan-300/10 px-4 py-2 text-xs font-semibold uppercase tracking-[0.24em] text-cyan-100 shadow-lg shadow-cyan-950/30 backdrop-blur-xl"
              >
                <span
                  class="h-2 w-2 rounded-full bg-cyan-300 shadow-[0_0_18px_rgba(103,232,249,0.95)]"
                ></span>
                Tecnología integral para PYMES
              </div>

              <div class="space-y-5">
                <h1
                  class="max-w-5xl text-balance text-4xl font-black leading-[1.02] tracking-tight text-white sm:text-5xl lg:text-6xl xl:text-7xl"
                >
                  Tecnología real para negocios que quieren
                  <span
                    class="bg-gradient-to-r from-cyan-200 via-sky-400 to-cyan-100 bg-clip-text text-transparent"
                  >
                    operar, vender y crecer mejor.
                  </span>
                </h1>

                <p
                  class="max-w-3xl text-pretty text-base leading-8 text-slate-300 sm:text-lg lg:text-xl"
                >
                  En <strong class="text-white"
                    >NeoTec Business Solutions</strong
                  >
                  desarrollamos software, puntos de venta, plataformas web y estrategias
                  digitales para PYMES que necesitan control, eficiencia y presencia
                  profesional.
                </p>

                <p
                  class="max-w-2xl text-sm leading-7 text-slate-400 sm:text-base"
                >
                  Desde la operación interna hasta la experiencia digital del
                  cliente, construimos soluciones que ayudan a tu negocio a
                  trabajar con más orden, menos pérdidas y mejores decisiones.
                </p>
              </div>

              <div class="flex flex-col gap-3 sm:flex-row">
                <a
                  href="/cotizar"
                  class="group inline-flex items-center justify-center gap-2 rounded-2xl bg-cyan-400 px-6 py-4 text-sm font-black uppercase tracking-wide text-slate-950 shadow-[0_0_35px_rgba(34,211,238,0.28)] transition duration-300 hover:-translate-y-1 hover:bg-cyan-300 hover:shadow-[0_0_50px_rgba(34,211,238,0.45)] focus:outline-none focus:ring-2 focus:ring-cyan-200"
                >
                  Solicitar diagnóstico
                  <span
                    class="transition duration-300 group-hover:translate-x-1"
                    set:html={icons.arrow}
                  />
                </a>

                <a
                  href="/productos"
                  class="inline-flex items-center justify-center rounded-2xl border border-slate-700/80 bg-slate-950/40 px-6 py-4 text-sm font-bold uppercase tracking-wide text-slate-100 backdrop-blur-xl transition duration-300 hover:-translate-y-1 hover:border-cyan-300/40 hover:bg-cyan-300/10 hover:text-cyan-100"
                >
                  Ver soluciones
                </a>
              </div>

              <div
                class="grid grid-cols-2 gap-3 pt-3 sm:max-w-2xl lg:max-w-3xl"
              >
                {
                  metrics.map((item, index) => (
                    <article
                      class="metric-card min-h-[132px] rounded-2xl border border-white/10 bg-white/[0.045] p-4 backdrop-blur-xl transition duration-300 hover:-translate-y-1 hover:border-cyan-300/35 hover:bg-cyan-300/[0.08] sm:min-h-[140px] sm:p-5"
                      style={`animation-delay:${index * 110}ms`}
                    >
                      <strong class="block text-3xl font-black leading-none text-cyan-200 sm:text-4xl">
                        {item.value}
                      </strong>

                      <span class="mt-3 block text-sm font-black leading-snug text-white sm:text-base">
                        {item.label}
                      </span>

                      <p class="mt-2 text-xs leading-5 text-slate-400 sm:text-sm">
                        {item.detail}
                      </p>
                    </article>
                  ))
                }
              </div>
            </div>

            <!-- Hero visual panel -->
            <aside
              class="reveal reveal-delay relative mx-auto w-full max-w-xl lg:max-w-none"
            >
              <div
                class="absolute -inset-6 rounded-[2rem] bg-cyan-400/10 blur-3xl"
                aria-hidden="true"
              >
              </div>

              <div
                class="relative overflow-hidden rounded-[2rem] border border-cyan-200/15 bg-slate-950/55 p-5 shadow-2xl shadow-cyan-950/40 backdrop-blur-2xl sm:p-6"
              >
                <div class="mb-5 flex items-center justify-between">
                  <div>
                    <p
                      class="text-xs font-bold uppercase tracking-[0.22em] text-cyan-200"
                    >
                      NeoTec Command Center
                    </p>
                    <h2 class="mt-1 text-xl font-black text-white">
                      Operación digital
                    </h2>
                  </div>
                  <div
                    class="rounded-full border border-cyan-300/20 bg-cyan-300/10 px-3 py-1 text-xs font-bold text-cyan-100"
                  >
                    Activo
                  </div>
                </div>

                <div class="grid gap-3 sm:grid-cols-2">
                  <div
                    class="rounded-2xl border border-white/10 bg-white/[0.045] p-4"
                  >
                    <p
                      class="text-xs uppercase tracking-[0.2em] text-slate-400"
                    >
                      Desarrollo
                    </p>
                    <p class="mt-2 text-2xl font-black text-white">
                      Plataforma
                    </p>
                    <div
                      class="mt-4 h-2 overflow-hidden rounded-full bg-slate-800"
                    >
                      <div class="progress-bar h-full rounded-full bg-cyan-300">
                      </div>
                    </div>
                    <p class="mt-3 text-xs text-slate-400">
                      Arquitectura, módulos y despliegue.
                    </p>
                  </div>

                  <div
                    class="rounded-2xl border border-white/10 bg-white/[0.045] p-4"
                  >
                    <p
                      class="text-xs uppercase tracking-[0.2em] text-slate-400"
                    >
                      Producto
                    </p>
                    <p class="mt-2 text-2xl font-black text-white">POS</p>
                    <div class="mt-4 grid grid-cols-5 gap-1">
                      <span class="h-8 rounded-lg bg-cyan-300/90"></span>
                      <span class="h-8 rounded-lg bg-cyan-300/70"></span>
                      <span class="h-8 rounded-lg bg-cyan-300/50"></span>
                      <span class="h-8 rounded-lg bg-cyan-300/35"></span>
                      <span class="h-8 rounded-lg bg-cyan-300/20"></span>
                    </div>
                    <p class="mt-3 text-xs text-slate-400">
                      Venta, caja, inventario y reportes.
                    </p>
                  </div>
                </div>

                <div
                  class="mt-3 rounded-2xl border border-white/10 bg-white/[0.045] p-4"
                >
                  <div class="mb-4 flex items-center justify-between">
                    <p
                      class="text-xs font-bold uppercase tracking-[0.2em] text-slate-400"
                    >
                      Ecosistema de soluciones
                    </p>
                    <span
                      class="h-2 w-2 rounded-full bg-cyan-300 shadow-[0_0_18px_rgba(103,232,249,0.95)]"
                    ></span>
                  </div>

                  <div class="space-y-3">
                    {
                      [
                        ["Software", "92%"],
                        ["Punto de venta", "88%"],
                        ["Web / microwebs", "84%"],
                        ["Redes sociales", "76%"],
                      ].map(([label, width]) => (
                        <div>
                          <div class="mb-1 flex items-center justify-between text-xs">
                            <span class="font-semibold text-slate-200">
                              {label}
                            </span>
                            <span class="text-cyan-200">{width}</span>
                          </div>
                          <div class="h-2 overflow-hidden rounded-full bg-slate-800/90">
                            <div
                              class="h-full rounded-full bg-gradient-to-r from-cyan-500 to-cyan-200"
                              style={`width:${width}`}
                            />
                          </div>
                        </div>
                      ))
                    }
                  </div>
                </div>

                <div
                  class="mt-3 rounded-2xl border border-cyan-300/15 bg-cyan-300/[0.06] p-4"
                >
                  <p class="text-sm leading-6 text-cyan-50">
                    “No vendemos tecnología aislada. Diseñamos sistemas,
                    procesos y presencia digital para que el negocio funcione
                    mejor.”
                  </p>
                </div>
              </div>
            </aside>
          </div>
        </div>
      </section>

      <!-- SOLUCIONES -->
      <section id="soluciones" class="px-4 py-20 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-[1440px]">
          <div class="reveal mx-auto max-w-3xl text-center">
            <span
              class="text-sm font-black uppercase tracking-[0.24em] text-cyan-200"
            >
              Lo que construimos
            </span>
            <h2
              class="mt-4 text-3xl font-black tracking-tight text-white sm:text-4xl lg:text-5xl"
            >
              Un ecosistema tecnológico para operar con orden.
            </h2>
            <p class="mt-5 text-base leading-8 text-slate-300 sm:text-lg">
              NeoTec integra desarrollo, implementación, soporte y estrategia
              digital. Porque una PYME no necesita veinte proveedores peleándose
              entre sí: necesita una solución clara que funcione.
            </p>
          </div>

          <div class="mt-12 grid gap-5 sm:grid-cols-2 xl:grid-cols-3">
            {
              solutions.map((item, index) => (
                <article
                  class="reveal solution-card group rounded-[1.7rem] border border-white/10 bg-slate-950/45 p-6 shadow-xl shadow-slate-950/30 backdrop-blur-xl transition duration-300 hover:-translate-y-2 hover:border-cyan-300/35 hover:bg-cyan-300/[0.065]"
                  style={`animation-delay:${index * 75}ms`}
                >
                  <div class="mb-5 flex h-14 w-14 items-center justify-center rounded-2xl border border-cyan-300/20 bg-cyan-300/10 text-cyan-200 transition duration-300 group-hover:scale-110 group-hover:bg-cyan-300/20">
                    <span set:html={item.icon} />
                  </div>
                  <h3 class="text-xl font-black text-white">{item.title}</h3>
                  <p class="mt-3 text-sm leading-7 text-slate-300">
                    {item.description}
                  </p>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <!-- DIFERENCIADOR -->
      <section class="px-4 py-20 sm:px-6 lg:px-8">
        <div
          class="mx-auto grid max-w-[1440px] gap-8 rounded-[2rem] border border-cyan-300/15 bg-cyan-950/[0.12] p-6 backdrop-blur-2xl sm:p-8 lg:grid-cols-[0.9fr_1.1fr] lg:p-10"
        >
          <div class="reveal">
            <span
              class="text-sm font-black uppercase tracking-[0.24em] text-cyan-200"
            >
              Por qué NeoTec
            </span>
            <h2 class="mt-4 text-3xl font-black text-white sm:text-4xl">
              No somos “otra agencia”. Somos el puente entre operación y
              tecnología.
            </h2>
            <p class="mt-5 text-base leading-8 text-slate-300">
              Trabajamos desde la realidad del negocio: ventas, caja,
              inventario, clientes, redes, procesos, errores humanos y
              herramientas mal conectadas. Ahí es donde la tecnología sí hace
              diferencia.
            </p>
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            {
              [
                "Soluciones pensadas para PYMES mexicanas.",
                "Desarrollo alineado a procesos reales.",
                "Visión integral: software, web, redes y soporte.",
                "Acompañamiento para implementación y mejora continua.",
              ].map((text, index) => (
                <article
                  class="reveal rounded-2xl border border-white/10 bg-white/[0.045] p-5"
                  style={`animation-delay:${index * 95}ms`}
                >
                  <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-xl bg-cyan-300/10 text-cyan-200">
                    <span set:html={icons.check} />
                  </div>
                  <p class="text-sm font-semibold leading-7 text-slate-200">
                    {text}
                  </p>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <!-- PRUEBA / TRACCIÓN -->
      <section class="px-4 py-20 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-[1440px]">
          <div class="grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:items-center">
            <div class="reveal">
              <span
                class="text-sm font-black uppercase tracking-[0.24em] text-cyan-200"
              >
                Ya estamos construyendo
              </span>
              <h2
                class="mt-4 text-3xl font-black text-white sm:text-4xl lg:text-5xl"
              >
                Proyectos reales, clientes reales, problemas reales.
              </h2>
              <p class="mt-5 text-base leading-8 text-slate-300">
                NeoTec está avanzando con clientes activos, productos propios y
                desarrollo de soluciones grandes. Esto no es presentación de
                PowerPoint: es ejecución.
              </p>
            </div>

            <div
              class="reveal reveal-delay rounded-[2rem] border border-white/10 bg-slate-950/50 p-5 backdrop-blur-2xl sm:p-6"
            >
              <div class="space-y-3">
                {
                  proof.map((item, index) => (
                    <div
                      class="flex gap-4 rounded-2xl border border-white/10 bg-white/[0.04] p-4 transition duration-300 hover:border-cyan-300/30 hover:bg-cyan-300/[0.055]"
                      style={`animation-delay:${index * 80}ms`}
                    >
                      <div class="mt-1 flex h-8 w-8 shrink-0 items-center justify-center rounded-xl bg-cyan-300/10 text-cyan-200">
                        <span set:html={icons.check} />
                      </div>
                      <p class="text-sm font-medium leading-7 text-slate-200">
                        {item}
                      </p>
                    </div>
                  ))
                }
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- PROCESO -->
      <section class="px-4 py-20 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-[1440px]">
          <div class="reveal mx-auto max-w-3xl text-center">
            <span
              class="text-sm font-black uppercase tracking-[0.24em] text-cyan-200"
            >
              Cómo trabajamos
            </span>
            <h2
              class="mt-4 text-3xl font-black text-white sm:text-4xl lg:text-5xl"
            >
              Menos improvisación. Más método.
            </h2>
            <p class="mt-5 text-base leading-8 text-slate-300">
              Cada solución parte de entender el negocio. La tecnología entra
              después, cuando ya sabemos qué problema debe resolver.
            </p>
          </div>

          <div class="mt-12 grid gap-5 md:grid-cols-2 xl:grid-cols-4">
            {
              process.map((item, index) => (
                <article
                  class="reveal process-card relative overflow-hidden rounded-[1.7rem] border border-white/10 bg-slate-950/45 p-6 backdrop-blur-xl transition duration-300 hover:-translate-y-2 hover:border-cyan-300/35 hover:bg-cyan-300/[0.055]"
                  style={`animation-delay:${index * 110}ms`}
                >
                  <span class="absolute right-5 top-4 text-5xl font-black text-cyan-300/[0.08]">
                    {item.step}
                  </span>
                  <div class="relative">
                    <div class="mb-5 flex h-12 w-12 items-center justify-center rounded-2xl border border-cyan-300/20 bg-cyan-300/10 text-sm font-black text-cyan-100">
                      {item.step}
                    </div>
                    <h3 class="text-xl font-black text-white">{item.title}</h3>
                    <p class="mt-3 text-sm leading-7 text-slate-300">
                      {item.text}
                    </p>
                  </div>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <!-- CTA FINAL -->
      <section class="px-4 py-20 sm:px-6 lg:px-8">
        <div
          class="reveal mx-auto max-w-[1200px] overflow-hidden rounded-[2.2rem] border border-cyan-300/20 bg-gradient-to-br from-cyan-300/[0.14] via-slate-950/70 to-slate-950/90 p-8 text-center shadow-2xl shadow-cyan-950/30 backdrop-blur-2xl sm:p-12"
        >
          <div
            class="mx-auto mb-6 flex h-14 w-14 items-center justify-center rounded-2xl border border-cyan-300/25 bg-cyan-300/10 text-cyan-100"
            set:html={icons.pulse}
          />
          <h2
            class="mx-auto max-w-4xl text-3xl font-black text-white sm:text-4xl lg:text-5xl"
          >
            ¿Tu negocio necesita orden, tecnología o presencia digital
            profesional?
          </h2>
          <p
            class="mx-auto mt-5 max-w-3xl text-base leading-8 text-slate-300 sm:text-lg"
          >
            Hablemos de tu operación y diseñemos una solución realista,
            escalable y rentable. Sin humo corporativo, sin promesas infladas y
            sin sistemas que terminan abandonados en una carpeta llamada
            “final_final_ahora_sí”.
          </p>

          <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
            <a
              href="/cotizar"
              class="group inline-flex items-center justify-center gap-2 rounded-2xl bg-cyan-300 px-7 py-4 text-sm font-black uppercase tracking-wide text-slate-950 shadow-[0_0_40px_rgba(34,211,238,0.32)] transition duration-300 hover:-translate-y-1 hover:bg-cyan-200"
            >
              Solicitar diagnóstico
              <span
                class="transition duration-300 group-hover:translate-x-1"
                set:html={icons.arrow}
              />
            </a>
            <a
              href="/productos"
              class="inline-flex items-center justify-center rounded-2xl border border-white/15 bg-white/[0.04] px-7 py-4 text-sm font-bold uppercase tracking-wide text-white transition duration-300 hover:-translate-y-1 hover:border-cyan-300/40 hover:bg-cyan-300/10"
            >
              Explorar soluciones
            </a>
          </div>
        </div>
      </section>
    </main>

    <Footer />

    <style>
      html {
        scroll-behavior: smooth;
      }

      body {
        background:
          radial-gradient(
            circle at top,
            rgba(14, 165, 233, 0.12),
            transparent 38%
          ),
          #020617;
      }

      .reveal {
        opacity: 0;
        transform: translateY(22px);
        animation: revealUp 0.9s cubic-bezier(0.22, 1, 0.36, 1) forwards;
      }

      .reveal-delay {
        animation-delay: 180ms;
      }

      .metric-card {
        opacity: 0;
        transform: translateY(18px) scale(0.98);
        animation: revealCard 0.75s cubic-bezier(0.22, 1, 0.36, 1) forwards;
      }

      .solution-card,
      .process-card {
        will-change: transform;
      }

      .progress-bar {
        width: 76%;
        animation: progressPulse 2.7s ease-in-out infinite;
      }

      @keyframes revealUp {
        from {
          opacity: 0;
          transform: translateY(22px);
        }

        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      @keyframes revealCard {
        from {
          opacity: 0;
          transform: translateY(18px) scale(0.98);
        }

        to {
          opacity: 1;
          transform: translateY(0) scale(1);
        }
      }

      @keyframes progressPulse {
        0%,
        100% {
          filter: brightness(1);
          box-shadow: 0 0 14px rgba(34, 211, 238, 0.25);
        }

        50% {
          filter: brightness(1.25);
          box-shadow: 0 0 26px rgba(34, 211, 238, 0.5);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }

        .reveal,
        .metric-card,
        .progress-bar {
          animation: none !important;
          opacity: 1 !important;
          transform: none !important;
        }
      }

      @media (max-width: 640px) {
        .text-balance {
          text-wrap: balance;
        }

        .text-pretty {
          text-wrap: pretty;
        }
      }
    </style>
  </body>
</html>

---
// src/pages/index.astro
import Navbar from "../componentes/navbar.astro";
import Footer from "../componentes/footer.astro";
import SEO from "../componentes/seo.astro";
import CircuitBG from "../componentes/CircuitBG.astro";
import "../styles/global.css";

const title =
  "NeoTec Business Solutions — Tecnología real para negocios que quieren crecer";
const description =
  "NeoTec Business Solutions desarrolla software, puntos de venta, plataformas web, microwebs, estrategias digitales y soluciones tecnológicas para PYMES que necesitan operar, vender y crecer mejor.";

const icons = {
  software: `<svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" viewBox="0 0 24 24" fill="currentColor"><path d="M4 4h16a2 2 0 012 2v9a2 2 0 01-2 2h-6v2h3v2H7v-2h3v-2H4a2 2 0 01-2-2V6a2 2 0 012-2zm0 2v9h16V6H4z"/></svg>`,
  pos: `<svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" viewBox="0 0 24 24" fill="currentColor"><path d="M5 3h14a2 2 0 012 2v11H3V5a2 2 0 012-2zm1 3v8h12V6H6zm-3 12h18v1a2 2 0 01-2 2H5a2 2 0 01-2-2v-1zm5-10h2v2H8V8zm4 0h2v2h-2V8z"/></svg>`,
  web: `<svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" viewBox="0 0 24 24" fill="currentColor"><path d="M3 4h18a2 2 0 012 2v12a2 2 0 01-2 2H3a2 2 0 01-2-2V6a2 2 0 012-2zm0 4v10h18V8H3zm2-3v2h2V5H5zm4 0v2h2V5H9z"/></svg>`,
  social: `<svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" viewBox="0 0 24 24" fill="currentColor"><path d="M4 5h16a2 2 0 012 2v10a2 2 0 01-2 2H8l-5 3v-3H4a2 2 0 01-2-2V7a2 2 0 012-2zm3 4v2h10V9H7zm0 4v2h7v-2H7z"/></svg>`,
  hardware: `<svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" viewBox="0 0 24 24" fill="currentColor"><path d="M7 2h10v2h3v3h2v10h-2v3h-3v2H7v-2H4v-3H2V7h2V4h3V2zm0 6v8h10V8H7zm2 2h6v4H9v-4z"/></svg>`,
  strategy: `<svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l9 5v6c0 5-3.8 9.7-9 11-5.2-1.3-9-6-9-11V7l9-5zm0 4.2L7 9v4.2c0 2.9 2 5.8 5 6.8 3-1 5-3.9 5-6.8V9l-5-2.8zm-1 10.3l-3-3 1.4-1.4 1.6 1.6 4.6-4.6 1.4 1.4-6 6z"/></svg>`,
  check: `<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d="M9 16.2l-3.5-3.5L4 14.2l5 5 11-11-1.5-1.5z"/></svg>`,
  arrow: `<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d="M13 5l7 7-7 7v-4H4v-6h9V5z"/></svg>`,
  pulse: `<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 1010 10A10.011 10.011 0 0012 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/></svg>`,
};

const metrics = [
  {
    value: "2+",
    label: "clientes activos",
    detail: "en gestión de redes y presencia digital",
  },
  {
    value: "1",
    label: "plataforma grande",
    detail: "en desarrollo para operación digital",
  },
  {
    value: "1",
    label: "POS completo",
    detail: "en construcción para venta e inventario",
  },
  {
    value: "360°",
    label: "visión integral",
    detail: "software, web, hardware y estrategia",
  },
];

const solutions = [
  {
    title: "Software empresarial",
    description:
      "Sistemas administrativos, plataformas internas, automatización, CRM/ERP y herramientas hechas para operar con orden.",
    icon: icons.software,
  },
  {
    title: "Punto de venta",
    description:
      "POS completo para ventas, caja, inventario, productos, clientes, reportes y control operativo.",
    icon: icons.pos,
  },
  {
    title: "Webs y microwebs",
    description:
      "Sitios profesionales, landing pages, tarjetas digitales y presencia web optimizada para negocios locales.",
    icon: icons.web,
  },
  {
    title: "Redes sociales",
    description:
      "Gestión estratégica de contenido, campañas, comunicación visual y presencia digital para negocios reales.",
    icon: icons.social,
  },
  {
    title: "Hardware y soporte",
    description:
      "Asesoría, configuración, mantenimiento, implementación técnica y acompañamiento para infraestructura física.",
    icon: icons.hardware,
  },
  {
    title: "Consultoría tecnológica",
    description:
      "Diagnóstico de procesos, selección de herramientas, mejora operativa y digitalización escalable para PYMES.",
    icon: icons.strategy,
  },
];

const process = [
  {
    step: "01",
    title: "Diagnóstico",
    text: "Entendemos tu operación real: cómo vendes, cómo cobras, cómo registras, dónde pierdes tiempo y qué procesos duelen.",
  },
  {
    step: "02",
    title: "Diseño de solución",
    text: "Definimos qué necesita tu negocio: software, POS, web, redes, hardware, automatización o una mezcla bien armada.",
  },
  {
    step: "03",
    title: "Implementación",
    text: "Construimos, configuramos, desplegamos y ajustamos con enfoque práctico. Nada de soluciones bonitas que nadie usa.",
  },
  {
    step: "04",
    title: "Acompañamiento",
    text: "Capacitamos, damos soporte y evolucionamos la solución conforme tu negocio crece o cambia de ritmo.",
  },
];

const proof = [
  "Gestión de redes sociales para negocios locales.",
  "Desarrollo de una plataforma digital de alto alcance.",
  "Construcción de un punto de venta completo.",
  "Microwebs profesionales para marcas, servicios y despachos.",
  "Soluciones pensadas para PYMES mexicanas, no para organigramas imaginarios.",
];
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <SEO
      title={title}
      description={description}
      type="website"
      locale="es_MX"
      url="https://tecno.vercel.app/"
      siteName="NeoTec Business Solutions"
      ogImage="/og-default.png"
      logo="/web-app-manifest-512x512.png"
      phone="+52 443 371 1589"
      email="contacto@tecno.mx"
      address={{
        streetAddress: "Morelia",
        addressLocality: "Morelia",
        addressRegion: "Michoacán",
        addressCountry: "MX",
      }}
    />
    <title>{title}</title>
  </head>

  <body
    class="min-h-screen overflow-x-hidden bg-slate-950 text-slate-100 selection:bg-cyan-400/30 selection:text-white"
  >
    <CircuitBG
      background="#050b18"
      trace="#e2e8f0"
      traceSoft="#94a3b8"
      chip="#f8fafc"
      opacity={0.28}
    />

    <Navbar />

    <main class="relative z-10">
      <!-- HERO -->
      <section
        class="relative min-h-[92svh] overflow-hidden px-4 pt-28 pb-12 sm:px-6 sm:pt-32 lg:px-8"
      >
        <div
          class="mx-auto flex min-h-[calc(92svh-7rem)] max-w-[1440px] items-center"
        >
          <div
            class="grid w-full gap-10 lg:grid-cols-[1.02fr_0.98fr] lg:items-center"
          >
            <!-- Copy -->
            <div class="reveal space-y-6">
              <div
                class="inline-flex max-w-full items-center gap-2 rounded-full border border-cyan-300/25 bg-cyan-300/10 px-4 py-2 text-[11px] font-black uppercase tracking-[0.22em] text-cyan-100 shadow-lg shadow-cyan-950/30 backdrop-blur-xl sm:text-xs"
              >
                <span
                  class="h-2 w-2 shrink-0 rounded-full bg-cyan-300 shadow-[0_0_18px_rgba(103,232,249,0.95)]"
                ></span>
                Tecnología integral para PYMES
              </div>

              <div class="space-y-5">
                <h1
                  class="max-w-5xl text-balance text-4xl font-black leading-[1.03] tracking-tight text-white sm:text-5xl lg:text-6xl xl:text-7xl"
                >
                  Tecnología real para
                  <span
                    class="bg-gradient-to-r from-cyan-200 via-sky-400 to-cyan-100 bg-clip-text text-transparent"
                  >
                    operar, vender y crecer mejor.
                  </span>
                </h1>

                <p
                  class="max-w-2xl text-pretty text-base leading-8 text-slate-300 sm:text-lg lg:text-xl"
                >
                  En <strong class="text-white"
                    >NeoTec Business Solutions</strong
                  >
                  desarrollamos software, puntos de venta, páginas web y estrategia
                  digital para negocios que necesitan más control, mejor presencia
                  y procesos claros.
                </p>
              </div>

              <div class="flex flex-col gap-3 sm:flex-row">
                <a
                  href="/cotizar"
                  class="group inline-flex items-center justify-center gap-2 rounded-2xl bg-cyan-400 px-6 py-4 text-sm font-black uppercase tracking-wide text-slate-950 shadow-[0_0_35px_rgba(34,211,238,0.28)] transition duration-300 hover:-translate-y-1 hover:bg-cyan-300 hover:shadow-[0_0_50px_rgba(34,211,238,0.45)] focus:outline-none focus:ring-2 focus:ring-cyan-200"
                >
                  Solicitar diagnóstico
                  <span
                    class="transition duration-300 group-hover:translate-x-1"
                    set:html={icons.arrow}
                  />
                </a>

                <a
                  href="/productos"
                  class="inline-flex items-center justify-center rounded-2xl border border-slate-700/80 bg-slate-950/40 px-6 py-4 text-sm font-bold uppercase tracking-wide text-slate-100 backdrop-blur-xl transition duration-300 hover:-translate-y-1 hover:border-cyan-300/40 hover:bg-cyan-300/10 hover:text-cyan-100"
                >
                  Ver soluciones
                </a>
              </div>

              <!-- Trust chips compactos -->
              <div
                class="grid grid-cols-1 gap-3 pt-2 sm:grid-cols-3 lg:max-w-3xl"
              >
                <div
                  class="rounded-2xl border border-white/10 bg-white/[0.045] px-4 py-3 backdrop-blur-xl"
                >
                  <strong class="block text-sm font-black text-white"
                    >Software</strong
                  >
                  <span class="text-xs text-slate-400">Sistemas a medida</span>
                </div>

                <div
                  class="rounded-2xl border border-white/10 bg-white/[0.045] px-4 py-3 backdrop-blur-xl"
                >
                  <strong class="block text-sm font-black text-white"
                    >POS</strong
                  >
                  <span class="text-xs text-slate-400">Ventas e inventario</span
                  >
                </div>

                <div
                  class="rounded-2xl border border-white/10 bg-white/[0.045] px-4 py-3 backdrop-blur-xl"
                >
                  <strong class="block text-sm font-black text-white"
                    >Web</strong
                  >
                  <span class="text-xs text-slate-400"
                    >Presencia profesional</span
                  >
                </div>
              </div>
            </div>

            <!-- Hero visual panel -->
            <aside
              class="reveal reveal-delay relative mx-auto hidden w-full max-w-xl md:block lg:max-w-none"
            >
              <div
                class="absolute -inset-6 rounded-[2rem] bg-cyan-400/10 blur-3xl"
                aria-hidden="true"
              >
              </div>

              <div
                class="relative overflow-hidden rounded-[2rem] border border-cyan-200/15 bg-slate-950/55 p-5 shadow-2xl shadow-cyan-950/40 backdrop-blur-2xl sm:p-6"
              >
                <div class="mb-5 flex items-center justify-between">
                  <div>
                    <p
                      class="text-xs font-bold uppercase tracking-[0.22em] text-cyan-200"
                    >
                      NeoTec Command Center
                    </p>
                    <h2 class="mt-1 text-xl font-black text-white">
                      Operación digital
                    </h2>
                  </div>

                  <div
                    class="rounded-full border border-cyan-300/20 bg-cyan-300/10 px-3 py-1 text-xs font-bold text-cyan-100"
                  >
                    Activo
                  </div>
                </div>

                <div class="grid gap-3 sm:grid-cols-2">
                  <div
                    class="rounded-2xl border border-white/10 bg-white/[0.045] p-4"
                  >
                    <p
                      class="text-xs uppercase tracking-[0.2em] text-slate-400"
                    >
                      Producto
                    </p>
                    <p class="mt-2 text-2xl font-black text-white">
                      NeoTec POS
                    </p>

                    <div class="mt-4 grid grid-cols-5 gap-1">
                      <span class="h-8 rounded-lg bg-cyan-300/90"></span>
                      <span class="h-8 rounded-lg bg-cyan-300/70"></span>
                      <span class="h-8 rounded-lg bg-cyan-300/50"></span>
                      <span class="h-8 rounded-lg bg-cyan-300/35"></span>
                      <span class="h-8 rounded-lg bg-cyan-300/20"></span>
                    </div>

                    <p class="mt-3 text-xs text-slate-400">
                      Venta, caja, inventario y reportes.
                    </p>
                  </div>

                  <div
                    class="rounded-2xl border border-white/10 bg-white/[0.045] p-4"
                  >
                    <p
                      class="text-xs uppercase tracking-[0.2em] text-slate-400"
                    >
                      Digital
                    </p>
                    <p class="mt-2 text-2xl font-black text-white">
                      Web + Media
                    </p>

                    <div
                      class="mt-4 h-2 overflow-hidden rounded-full bg-slate-800"
                    >
                      <div class="progress-bar h-full rounded-full bg-cyan-300">
                      </div>
                    </div>

                    <p class="mt-3 text-xs text-slate-400">
                      Presencia, marca y estrategia comercial.
                    </p>
                  </div>
                </div>

                <div
                  class="mt-3 rounded-2xl border border-cyan-300/15 bg-cyan-300/[0.06] p-4"
                >
                  <p class="text-sm leading-6 text-cyan-50">
                    Sistemas, procesos y presencia digital para que el negocio
                    trabaje mejor.
                  </p>
                </div>
              </div>
            </aside>
          </div>
        </div>
      </section>

      <!-- SOLUCIONES + DIFERENCIADOR -->
      <section
        id="soluciones"
        class="px-4 py-14 sm:px-6 sm:py-18 lg:px-8 lg:py-20"
      >
        <div class="mx-auto max-w-[1440px]">
          <!-- Header compacto -->
          <div class="reveal mx-auto max-w-4xl text-center">
            <span
              class="text-xs font-black uppercase tracking-[0.24em] text-cyan-200 sm:text-sm"
            >
              Soluciones NeoTec
            </span>

            <h2
              class="mt-4 text-3xl font-black tracking-tight text-white sm:text-4xl lg:text-5xl"
            >
              Tecnología para operar, vender y crecer con más control.
            </h2>

            <p
              class="mx-auto mt-5 max-w-3xl text-sm leading-7 text-slate-300 sm:text-base sm:leading-8 lg:text-lg"
            >
              Integramos software, POS, web, soporte y estrategia digital para
              que tu negocio tenga herramientas conectadas, procesos claros y
              presencia profesional.
            </p>
          </div>

          <!-- Cards 2x2 en móvil -->
          <div class="mt-10 grid grid-cols-2 gap-3 sm:gap-5 lg:grid-cols-3">
            {
              solutions.map((item, index) => (
                <article
                  class="
              reveal solution-card group relative overflow-hidden rounded-2xl border border-white/10
              bg-slate-950/45 p-4 shadow-xl shadow-slate-950/25 backdrop-blur-xl
              transition duration-300 hover:-translate-y-1 hover:border-cyan-300/35 hover:bg-cyan-300/[0.065]
              sm:rounded-[1.5rem] sm:p-5 lg:p-6
            "
                  style={`animation-delay:${index * 70}ms`}
                >
                  <div
                    class="
                pointer-events-none absolute inset-0 opacity-0 transition duration-300 group-hover:opacity-100
                bg-[radial-gradient(circle_at_top_left,rgba(34,211,238,0.13),transparent_48%)]
              "
                  />

                  <div class="relative">
                    <div
                      class="
                  mb-4 flex h-11 w-11 items-center justify-center rounded-xl border border-cyan-300/20
                  bg-cyan-300/10 text-cyan-200 transition duration-300
                  group-hover:scale-105 group-hover:bg-cyan-300/20
                  sm:h-12 sm:w-12 sm:rounded-2xl
                "
                    >
                      <span
                        class="[&>svg]:h-5 [&>svg]:w-5 sm:[&>svg]:h-6 sm:[&>svg]:w-6"
                        set:html={item.icon}
                      />
                    </div>

                    <h3 class="text-sm font-black leading-snug text-white sm:text-lg lg:text-xl">
                      {item.title}
                    </h3>

                    <p class="mt-2 text-xs leading-5 text-slate-400 sm:text-sm sm:leading-6">
                      {item.description}
                    </p>
                  </div>
                </article>
              ))
            }
          </div>

          <!-- Diferenciador condensado -->
          <div
            class="reveal mt-10 grid gap-5 rounded-[1.7rem] border border-cyan-300/15
        bg-cyan-950/[0.12] p-5 backdrop-blur-2xl
        sm:p-7 lg:grid-cols-[0.9fr_1.1fr] lg:items-center lg:p-8"
          >
            <div>
              <span
                class="text-xs font-black uppercase tracking-[0.24em] text-cyan-200 sm:text-sm"
              >
                Por qué NeoTec
              </span>

              <h2
                class="mt-3 text-2xl font-black leading-tight text-white sm:text-3xl lg:text-4xl"
              >
                No somos otra agencia: conectamos operación, tecnología y marca.
              </h2>

              <p
                class="mt-4 text-sm leading-7 text-slate-300 sm:text-base sm:leading-8"
              >
                Partimos de cómo trabaja tu negocio: ventas, caja, inventario,
                clientes, redes, soporte y procesos. La tecnología entra donde
                realmente mejora algo.
              </p>
            </div>

            <div class="grid grid-cols-2 gap-3 sm:gap-4">
              {
                [
                  "Pensado para PYMES mexicanas.",
                  "Desarrollo alineado a procesos reales.",
                  "Software, web, redes y soporte en una sola visión.",
                  "Acompañamiento para implementar y mejorar.",
                ].map((text, index) => (
                  <article
                    class="
                reveal rounded-2xl border border-white/10 bg-white/[0.045] p-4
                transition duration-300 hover:border-cyan-300/25 hover:bg-cyan-300/[0.07]
                sm:p-5
              "
                    style={`animation-delay:${index * 90}ms`}
                  >
                    <div class="mb-3 flex h-9 w-9 items-center justify-center rounded-xl bg-cyan-300/10 text-cyan-200">
                      <span
                        class="[&>svg]:h-4 [&>svg]:w-4"
                        set:html={icons.check}
                      />
                    </div>

                    <p class="text-xs font-semibold leading-5 text-slate-200 sm:text-sm sm:leading-6">
                      {text}
                    </p>
                  </article>
                ))
              }
            </div>
          </div>
        </div>
      </section>

      <!-- TRACCIÓN + PROCESO -->
      <section class="px-4 py-14 sm:px-6 sm:py-16 lg:px-8 lg:py-20">
        <div class="mx-auto max-w-[1440px]">
          <div
            class="grid gap-8 rounded-[2rem] border border-cyan-300/15 bg-slate-950/50 p-5 backdrop-blur-2xl sm:p-7 lg:grid-cols-[0.9fr_1.1fr] lg:p-9"
          >
            <!-- Texto principal -->
            <div class="reveal">
              <span
                class="text-xs font-black uppercase tracking-[0.24em] text-cyan-200 sm:text-sm"
              >
                Ejecución real
              </span>

              <h2
                class="mt-4 text-3xl font-black leading-tight text-white sm:text-4xl lg:text-5xl"
              >
                Proyectos reales. Método claro.
              </h2>

              <p
                class="mt-5 text-sm leading-7 text-slate-300 sm:text-base sm:leading-8"
              >
                NeoTec ya trabaja con clientes activos, productos propios y
                soluciones digitales en desarrollo. No vendemos humo:
                diagnosticamos, construimos, implementamos y acompañamos.
              </p>

              <div class="mt-6 grid grid-cols-2 gap-3">
                <div
                  class="rounded-2xl border border-white/10 bg-white/[0.045] p-4"
                >
                  <strong class="block text-2xl font-black text-cyan-200"
                    >2+</strong
                  >
                  <span
                    class="mt-1 block text-xs font-semibold leading-5 text-slate-300"
                  >
                    clientes activos
                  </span>
                </div>

                <div
                  class="rounded-2xl border border-white/10 bg-white/[0.045] p-4"
                >
                  <strong class="block text-2xl font-black text-cyan-200"
                    >360°</strong
                  >
                  <span
                    class="mt-1 block text-xs font-semibold leading-5 text-slate-300"
                  >
                    visión tecnológica
                  </span>
                </div>
              </div>
            </div>

            <!-- Cards compactas -->
            <div class="grid grid-cols-2 gap-3 sm:gap-4">
              {
                [
                  {
                    step: "01",
                    title: "Diagnóstico",
                    text: "Entendemos operación, ventas, caja, procesos y dolores reales.",
                  },
                  {
                    step: "02",
                    title: "Diseño",
                    text: "Definimos la solución: software, POS, web, redes o soporte.",
                  },
                  {
                    step: "03",
                    title: "Implementación",
                    text: "Construimos, configuramos y ajustamos con enfoque práctico.",
                  },
                  {
                    step: "04",
                    title: "Mejora",
                    text: "Capacitamos, damos soporte y evolucionamos la solución.",
                  },
                ].map((item, index) => (
                  <article
                    class="
                reveal relative overflow-hidden rounded-2xl border border-white/10
                bg-white/[0.045] p-4 backdrop-blur-xl transition duration-300
                hover:-translate-y-1 hover:border-cyan-300/30 hover:bg-cyan-300/[0.065]
                sm:p-5
              "
                    style={`animation-delay:${index * 90}ms`}
                  >
                    <span class="absolute right-4 top-3 text-4xl font-black text-cyan-300/[0.08]">
                      {item.step}
                    </span>

                    <div class="relative">
                      <div class="mb-4 flex h-9 w-9 items-center justify-center rounded-xl border border-cyan-300/20 bg-cyan-300/10 text-xs font-black text-cyan-100">
                        {item.step}
                      </div>

                      <h3 class="text-sm font-black text-white sm:text-lg">
                        {item.title}
                      </h3>


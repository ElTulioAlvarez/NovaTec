    <Footer />

    <style>
      html {
        scroll-behavior: smooth;
      }

      body {
        background:
          radial-gradient(
            circle at top,
            rgba(14, 165, 233, 0.12),
            transparent 38%
          ),
          #020617;
      }

      .reveal {
        opacity: 0;
        transform: translateY(22px);
        animation: revealUp 0.9s cubic-bezier(0.22, 1, 0.36, 1) forwards;
      }

      .reveal-delay {
        animation-delay: 180ms;
      }

      .metric-card {
        opacity: 0;
        transform: translateY(18px) scale(0.98);
        animation: revealCard 0.75s cubic-bezier(0.22, 1, 0.36, 1) forwards;
      }

      .solution-card,
      .process-card {
        will-change: transform;
      }

      .progress-bar {
        width: 76%;
        animation: progressPulse 2.7s ease-in-out infinite;
      }

      @keyframes revealUp {
        from {
          opacity: 0;
          transform: translateY(22px);
        }

        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      @keyframes revealCard {
        from {
          opacity: 0;
          transform: translateY(18px) scale(0.98);
        }

        to {
          opacity: 1;
          transform: translateY(0) scale(1);
        }
      }

      @keyframes progressPulse {
        0%,
        100% {
          filter: brightness(1);
          box-shadow: 0 0 14px rgba(34, 211, 238, 0.25);
        }

        50% {
          filter: brightness(1.25);
          box-shadow: 0 0 26px rgba(34, 211, 238, 0.5);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }

        .reveal,
        .metric-card,
        .progress-bar {
          animation: none !important;
          opacity: 1 !important;
          transform: none !important;
        }
      }

      @media (max-width: 640px) {
        .text-balance {
          text-wrap: balance;
        }

        .text-pretty {
          text-wrap: pretty;
        }
      }
    </style>
  </body>
</html>

---
const PROFILE = {
  brand: "EDSA Construcción y Remodelación",
  shortBrand: "EDSA",
  contact: "Ing. Eduardo Santos Espinoza",
  role: "Jefe de Obra",
  phone: "4432445105",
  email: "edsaremodelaciones12@gmail.com",
  facebook: "https://www.facebook.com/profile.php?id=61585780644956",
  city: "Morelia, Michoacán",
  heroTitle: "Construcción y remodelación con ejecución firme, acabados sólidos y presencia profesional.",
  heroText:
    "EDSA desarrolla trabajos de construcción y remodelación con enfoque práctico, atención directa y criterio de obra. Soluciones funcionales, bien hechas y con seguimiento serio desde el arranque hasta la entrega.",
};

const waMessage = encodeURIComponent(
  `Hola, me interesa recibir información sobre los servicios de ${PROFILE.brand}. Quisiera una cotización.`,
);

const waLink = `https://wa.me/52${PROFILE.phone}?text=${waMessage}`;
const telLink = `tel:+52${PROFILE.phone}`;
const mailLink = `mailto:${PROFILE.email}`;
const fbLink = PROFILE.facebook;

const constructionServices = [
  {
    title: "Cimientos",
    desc: "Base estructural ejecutada con criterio técnico, preparación adecuada del terreno y atención a la estabilidad del proyecto.",
    image: "/edsa/serv-cimientos.png",
  },
  {
    title: "Acabados",
    desc: "Detalles finales, recubrimientos y terminados que elevan la calidad visual y funcional del espacio.",
    image: "/edsa/serv-acabados.jpg",
  },
  {
    title: "Trabajo en ladrillo",
    desc: "Muros, divisiones y soluciones constructivas con ejecución limpia, resistente y bien alineada.",
    image: "/edsa/serv-ladrillo.png",
  },
];

const remodelingServices = [
  {
    title: "Pisos",
    desc: "Instalación, sustitución y renovación de pisos para mejorar imagen, resistencia y confort.",
    image: "/edsa/serv-pisos.jpg",
  },
  {
    title: "Texturizado",
    desc: "Aplicaciones decorativas y técnicas para muros y superficies con mejor presencia y carácter visual.",
    image: "/edsa/serv-texturizado.jpg",
  },
  {
    title: "Pintura",
    desc: "Pintura interior y exterior con preparación correcta, uniformidad y terminación profesional.",
    image: "/edsa/serv-pintura.png",
  },
];

const processItems = [
  {
    title: "1. Levantamiento y revisión inicial",
    body: "Se analiza el espacio, las necesidades del cliente y el alcance real del trabajo para detectar condiciones técnicas, materiales requeridos y posibles restricciones de ejecución.",
  },
  {
    title: "2. Definición del servicio",
    body: "Se determina si el proyecto corresponde a construcción, remodelación o una combinación de ambos, estableciendo objetivos claros y prioridades de obra.",
  },
  {
    title: "3. Cotización y propuesta",
    body: "Se presenta una propuesta con referencia de trabajos, alcances, tiempos estimados y costos para que el cliente tenga claridad antes de iniciar.",
  },
  {
    title: "4. Planeación de obra",
    body: "Se organizan materiales, secuencia de ejecución, mano de obra y tiempos para realizar el proyecto con orden y control.",
  },
  {
    title: "5. Ejecución y seguimiento",
    body: "Se desarrollan los trabajos en sitio con supervisión, comunicación y control del avance para mantener calidad y continuidad.",
  },
  {
    title: "6. Revisión final y entrega",
    body: "Se verifican detalles, se ajustan pendientes finales y se entrega el trabajo con funcionamiento, imagen y terminación adecuada.",
  },
];

const gallery = Array.from({ length: 12 }, (_, i) => ({
  src: `/edsa/${i + 1}.jpeg`,
  alt: `Galería EDSA Construcción y Remodelación ${i + 1}`,
}));

const stats = [
  { label: "Enfoque", value: "Construcción y remodelación" },
  { label: "Atención", value: "Directa y profesional" },
  { label: "Cobertura", value: "Morelia, Michoacán" },
];

          sans-serif;
        background:
          radial-gradient(circle at 20% 0%, rgba(242, 194, 48, 0.1), transparent 25%),
          radial-gradient(circle at 100% 10%, rgba(242, 194, 48, 0.08), transparent 20%),
          linear-gradient(180deg, #0a0a0a 0%, #101010 52%, #121212 100%);
        overflow-x: hidden;
      }

      .wrap {
        width: min(var(--max), calc(100% - 36px));
        margin: 0 auto;
        padding: 18px 0 48px;
      }

      .panel {
        position: relative;
        border-radius: var(--radius-xl);
        border: 1px solid var(--line);
        background:
          linear-gradient(180deg, rgba(23, 23, 23, 0.94), rgba(12, 12, 12, 0.97));
        box-shadow: var(--shadow);
        overflow: hidden;
      }

      .panel::before {
        content: "";
        position: absolute;
        inset: 0;
        pointer-events: none;
        background:
          linear-gradient(
            135deg,
            transparent 35%,
            rgba(255, 255, 255, 0.025) 48%,
            transparent 62%
          ),
          radial-gradient(
            circle at 0% 0%,
            rgba(242, 194, 48, 0.08),
            transparent 30%
          );
      }

      .panel::after {
        content: "";
        position: absolute;
        inset: 0;
        border-radius: inherit;
        pointer-events: none;
        box-shadow:
          inset 0 0 0 1px rgba(242, 194, 48, 0.04),
          inset 0 0 0 2px rgba(255, 255, 255, 0.015);
      }

      .panel-blur {
        backdrop-filter: blur(12px);
      }

      [data-reveal] {
        opacity: 0;
        transform: translateY(10px);
        transition:
          opacity 0.55s ease,
          transform 0.55s ease;
      }

      [data-reveal].is-in {
        opacity: 1;
        transform: translateY(0);
      }

      [data-reveal-child] {
        opacity: 0;
        transform: translateY(10px);
        transition:
          opacity 0.55s ease,
          transform 0.55s ease;
        transition-delay: var(--d, 0ms);
      }

      .is-in [data-reveal-child] {
        opacity: 1;
        transform: translateY(0);
      }

      .hero {
        min-height: min(980px, 100dvh);
        padding: 28px;
        display: grid;
        gap: 24px;
        background:
          linear-gradient(180deg, rgba(16, 16, 16, 0.94), rgba(8, 8, 8, 0.98));
      }

      .heroGlow {
        position: absolute;
        inset: 0;
        pointer-events: none;
        background:
          radial-gradient(circle at 22% 18%, rgba(242, 194, 48, 0.12), transparent 26%),
          radial-gradient(circle at 85% 18%, rgba(242, 194, 48, 0.08), transparent 20%);
      }

      .heroLines {
        position: absolute;
        inset: 0;
        pointer-events: none;
        background:
          linear-gradient(90deg, transparent 0 8%, rgba(242, 194, 48, 0.04) 8% 8.2%, transparent 8.2% 100%),
          linear-gradient(0deg, transparent 0 88%, rgba(242, 194, 48, 0.05) 88% 88.2%, transparent 88.2% 100%);
        opacity: 0.85;
      }

      .hazardTape {
        position: absolute;
        left: -10%;
        width: 140%;
        height: 14px;
        background:
          repeating-linear-gradient(
            -45deg,
            #111 0 14px,
            #111 14px 28px,
            #f2c230 28px 42px,
            #f2c230 42px 56px
          );
        opacity: 0.14;
        pointer-events: none;
      }

      .tapeTop {
        top: 18px;
      }

      .tapeBottom {
        bottom: 18px;
      }

      .heroGrid {
        position: relative;
        z-index: 1;
        display: grid;
        grid-template-columns: minmax(320px, 0.9fr) minmax(420px, 1.1fr);
        align-items: center;
        gap: 34px;
      }

      .heroVisual {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 14px;
      }

      .logoPlate {
        width: min(520px, 100%);
        padding: 26px;
        border-radius: 34px;
        background:
          linear-gradient(180deg, rgba(24, 24, 24, 0.98), rgba(10, 10, 10, 0.98));
      }

      .logo {
        width: 100%;
        display: block;
        border-radius: 24px;
        object-fit: contain;
        filter:
          drop-shadow(0 20px 42px rgba(242, 194, 48, 0.12));
      }

      .heroContent {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        justify-content: center;
        text-align: left;
        max-width: 720px;
      }

      .kicker {
        margin: 0 0 12px;
        color: var(--yellow-2);
        font-size: 0.95rem;
        font-weight: 900;
        letter-spacing: 0.1em;
        text-transform: uppercase;
      }

      h1 {
        margin: 0;
        font-size: clamp(2.8rem, 5vw, 5.3rem);
        line-height: 0.98;
        letter-spacing: -0.045em;
        max-width: 11ch;
        text-wrap: balance;
      }

      .subtitle {
        margin: 18px 0 0;
        color: var(--muted);
        font-size: clamp(1rem, 1.12vw, 1.1rem);
        line-height: 1.68;
        max-width: 42rem;
      }

      .ctaRow {
        margin-top: 24px;
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
      }

      .btn {
        position: relative;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 54px;
        padding: 14px 22px;
        border-radius: 15px;
        border: 1px solid transparent;
        text-decoration: none;
        font-weight: 900;
        letter-spacing: 0.02em;
        transition:
          transform 0.16s ease,
          border-color 0.16s ease,
          box-shadow 0.16s ease;
      }

      .btn:hover {
        transform: translateY(-1px);
      }

      .primary {
        color: #111;
        background: linear-gradient(90deg, var(--yellow), var(--yellow-2));
        border-color: rgba(255, 255, 255, 0.05);
        box-shadow: 0 12px 28px rgba(242, 194, 48, 0.16);
      }

      .ghost {
        color: var(--white);
        background: rgba(255, 255, 255, 0.03);
        border-color: rgba(242, 194, 48, 0.22);
      }

      .btnGlow {
        position: absolute;
        inset: -2px;
        border-radius: 16px;
        pointer-events: none;
        background: radial-gradient(
          220px 80px at 40% 10%,
          rgba(255, 255, 255, 0.34),
          transparent 60%
        );
        opacity: 0.35;
      }

      .heroStats {
        margin-top: 22px;
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 12px;
        width: 100%;
      }

      .statCard {
        padding: 14px 16px;
        border-radius: 18px;
      }

      .statLabel {
        display: block;
        margin-bottom: 6px;
        color: var(--yellow-2);
        font-size: 0.74rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 0.08em;
      }

      .statCard strong {
        display: block;
        line-height: 1.35;
        font-size: 0.96rem;
      }

      .quick {
        position: relative;
        z-index: 2;
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 14px;
      }

      .qbtn {
        padding: 16px;
        min-height: 108px;
        text-decoration: none;
        color: var(--white);
        display: flex;
        align-items: center;
        gap: 14px;
        transition:
          transform 0.16s ease,
          border-color 0.16s ease;
      }

      .qbtn:hover {
        transform: translateY(-2px);
        border-color: var(--line-strong);
      }

      .qicon {
        width: 54px;
        height: 54px;
        display: grid;
        place-items: center;
        border-radius: 16px;
        background:
          linear-gradient(180deg, rgba(242, 194, 48, 0.18), rgba(242, 194, 48, 0.08));
        border: 1px solid rgba(242, 194, 48, 0.24);
        color: var(--yellow-2);
        flex-shrink: 0;
      }

      .qtext {
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 4px;
      }

      .qtitle {
        font-size: 1rem;
        font-weight: 900;
      }

      .qmeta {
        color: var(--muted);
        font-size: 0.9rem;
        line-height: 1.35;
        overflow-wrap: anywhere;
      }

      .qsvg {
        display: block;
        overflow: visible;
      }

      .qsvg * {
        vector-effect: non-scaling-stroke;
      }

      .qsvg-phone,
      .qsvg-whatsapp,
      .qsvg-mail {
        width: 21px;
        height: 21px;
      }

      .qsvg-facebook {
        width: 19px;
        height: 19px;
      }

      .section {
        margin-top: 34px;
      }

      .sectionHead {
        padding: 8px 6px 18px;
      }

      .sectionTag {
        margin: 0 0 6px;
        color: var(--yellow-2);
        font-size: 0.82rem;
        font-weight: 900;
        letter-spacing: 0.1em;
        text-transform: uppercase;
      }

      .sectionHead h2 {
        margin: 0;
        font-size: clamp(1.4rem, 2vw, 2rem);
      }

      .sectionHead p {
        margin: 8px 0 0;
        color: var(--muted);
        line-height: 1.7;
        max-width: 78ch;
      }

      .cards {
        display: grid;
        gap: 16px;
      }

      .serviceGrid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }

      .card-media {
        border-radius: 22px;
        min-height: 340px;
        padding: 0;
      }

      .cardBg {
        position: absolute;
        inset: 0;
      }

      .cardBg img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transform: scale(1.02);
        filter: saturate(0.95) contrast(1.04) brightness(0.58);
      }

      .cardOverlay {
        position: absolute;
        inset: 0;
        background:
          linear-gradient(180deg, rgba(10, 10, 10, 0.16), rgba(10, 10, 10, 0.82)),
          linear-gradient(90deg, rgba(10, 10, 10, 0.8), rgba(10, 10, 10, 0.18)),
          radial-gradient(circle at top left, rgba(242, 194, 48, 0.14), transparent 30%);
      }

      .cardContent {
        position: relative;
        z-index: 2;
        min-height: 340px;
        padding: 20px;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        gap: 10px;
      }

      .cardContent h3 {
        margin: 0;
        font-size: 1.12rem;
        line-height: 1.16;
      }

      .cardDesc {
        margin: 0;
        color: rgba(255, 255, 255, 0.84);
        font-size: 0.96rem;
        line-height: 1.6;
      }

      .cardActions {
        margin-top: 2px;
      }

      .link {
        display: inline-flex;
        color: var(--yellow-2);
        text-decoration: none;
        font-weight: 900;
      }

      .link:hover {
        text-decoration: underline;
      }

      .accordionWrap {
        display: grid;
        gap: 12px;
      }

      .accordion {
        border-radius: 20px;
      }

      .accordion summary {
        list-style: none;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        padding: 18px;
        font-weight: 800;
      }

      .accordion summary::-webkit-details-marker {
        display: none;
      }

      .accordion[open] summary {
        border-bottom: 1px solid rgba(242, 194, 48, 0.12);
      }

      .plus {
        width: 30px;
        height: 30px;
        display: grid;
        place-items: center;
        border-radius: 999px;
        background: rgba(242, 194, 48, 0.1);
        border: 1px solid rgba(242, 194, 48, 0.18);
        color: var(--yellow-2);
        transition: transform 0.2s ease;
        flex: 0 0 auto;
      }

      .accordion[open] .plus {
        transform: rotate(45deg);
      }

      .accordionBody {
        padding: 0 18px 18px;
      }

      .accordionBody p {
        margin: 0;
        color: var(--muted);
        line-height: 1.78;
      }

      .galleryShell {
        padding: 18px;
      }

      .galleryTrack {
        display: grid;
        grid-auto-flow: column;
        grid-auto-columns: minmax(320px, 32%);
        gap: 16px;
        overflow-x: auto;
        padding-bottom: 8px;
        cursor: grab;
        scroll-snap-type: x proximity;
        scrollbar-width: thin;
        scrollbar-color: rgba(242, 194, 48, 0.26) transparent;
      }

      .galleryTrack.dragging {
        cursor: grabbing;
      }

      .galleryTrack::-webkit-scrollbar {
        height: 10px;
      }

      .galleryTrack::-webkit-scrollbar-thumb {
        background: rgba(242, 194, 48, 0.24);
        border-radius: 999px;
      }

      .galleryItem {
        position: relative;
        border: 1px solid rgba(242, 194, 48, 0.18);
        background: rgba(255, 255, 255, 0.02);
        padding: 0;
        border-radius: 20px;
        overflow: hidden;
        cursor: pointer;
        box-shadow: var(--shadow);
        scroll-snap-align: start;
        aspect-ratio: 4 / 3;
      }

      .galleryItem::before {
        content: "";
        position: absolute;
        inset: 0;
        z-index: 1;
        pointer-events: none;
        background: linear-gradient(
          180deg,
          rgba(10, 10, 10, 0.02) 0%,
          rgba(10, 10, 10, 0.08) 55%,
          rgba(10, 10, 10, 0.24) 100%
        );
      }

      .galleryItem::after {
        content: "Zoom";
        position: absolute;
        right: 12px;
        bottom: 12px;
        z-index: 2;
        border-radius: 999px;
        padding: 8px 11px;
        font-size: 0.78rem;
        font-weight: 800;
        background: rgba(10, 10, 10, 0.7);
        border: 1px solid rgba(242, 194, 48, 0.22);
        color: var(--yellow-2);
        backdrop-filter: blur(6px);
      }

      .galleryItem img {
        width: 100%;
        height: 100%;
        display: block;
        object-fit: cover;
        object-position: center;
        transition:
          transform 0.32s ease,
          filter 0.32s ease;
        filter: brightness(0.92);
      }

      .galleryItem:hover img {
        transform: scale(1.04);
      }

      .contactGrid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 14px;
      }

      .contactCard {
        padding: 18px;
        border-radius: 22px;
      }

      .contactLabel {
        display: block;
        margin-bottom: 8px;
        color: var(--yellow-2);
        font-size: 0.78rem;
        font-weight: 900;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .contactCard strong {
        display: block;
        line-height: 1.4;
        font-size: 1rem;
      }

      .contactMeta {
        display: block;
        margin-top: 4px;
        color: var(--muted);
      }

      .break {
        overflow-wrap: anywhere;
      }

      .quote {
        margin-top: 34px;
      }

      .quoteBox {
        padding: 26px;
      }

      .quoteBox h2 {
        margin: 0;
        font-size: clamp(1.3rem, 2vw, 1.95rem);
      }

      .quoteBox p {
        margin: 10px 0 0;
        color: var(--muted);
        line-height: 1.7;
        max-width: 86ch;
      }

      .quoteBtns {
        margin-top: 18px;
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
      }

      .mini {
        margin-top: 14px;
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        color: var(--muted);
        font-weight: 700;
      }

      .footer {
        margin-top: 22px;
        padding: 10px 4px;
        text-align: center;
        color: rgba(255, 255, 255, 0.58);
        font-size: 0.92rem;
      }

      .zoomModal {
        position: fixed;
        inset: 0;
        z-index: 80;
        display: none;
      }

      .zoomModal.is-open {
        display: block;
      }

      .zoomBackdrop {
        position: absolute;
        inset: 0;
        border: 0;
        background: rgba(0, 0, 0, 0.84);
        cursor: pointer;
      }

      .zoomDialog {
        position: absolute;
        inset: 50%;
        transform: translate(-50%, -50%);
        width: min(92vw, 1100px);
        max-height: 88vh;
        border-radius: 22px;
        background: rgba(10, 10, 10, 0.95);
        border: 1px solid rgba(242, 194, 48, 0.18);
        box-shadow: 0 24px 54px rgba(0, 0, 0, 0.52);
        padding: 14px;
      }

      .zoomDialog img {
        width: 100%;
        max-height: calc(88vh - 28px);
        object-fit: contain;
        display: block;
        border-radius: 16px;
      }

      .zoomClose {
        position: absolute;
        top: 10px;
        right: 10px;
        width: 42px;
        height: 42px;
        border-radius: 999px;
        border: 1px solid rgba(242, 194, 48, 0.18);
        background: rgba(10, 10, 10, 0.74);
        color: white;
        font-size: 1.5rem;
        cursor: pointer;
        z-index: 2;
      }

      @media (hover: hover) and (pointer: fine) {
        .card-media .cardBg img {
          transition: transform 0.35s ease;
        }

        .card-media:hover .cardBg img {
          transform: scale(1.05);
        }
      }

      @media (max-width: 1180px) {
        .hero {
          min-height: auto;
        }

        .heroGrid {
          grid-template-columns: 1fr;
          gap: 22px;
        }

        .heroContent {
          align-items: center;
          text-align: center;
          max-width: 100%;
        }

        h1 {
          max-width: 11ch;
          font-size: clamp(2.4rem, 6vw, 4rem);
        }

        .subtitle {
          max-width: 46rem;
        }

        .heroStats {
          grid-template-columns: repeat(3, minmax(0, 1fr));
        }

        .serviceGrid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .galleryTrack {
          grid-auto-columns: minmax(320px, 48%);
        }

        .contactGrid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }

      @media (max-width: 820px) {
        .wrap {
          width: min(var(--max), calc(100% - 24px));
          padding: 14px 0 42px;
        }

        .hero {
          padding: 18px;
          gap: 18px;
        }

        h1 {
          font-size: clamp(2rem, 9vw, 3rem);
          max-width: 100%;
        }

        .subtitle {
          font-size: 0.98rem;
          line-height: 1.58;
        }

        .ctaRow {
          width: 100%;
          flex-direction: column;
        }

        .ctaRow .btn {
          width: 100%;
        }

        .heroStats {
          grid-template-columns: 1fr;
        }

        .quick {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .qbtn {
          min-height: 94px;
        }

        .serviceGrid {
          grid-template-columns: 1fr;
        }

        .card-media,
        .cardContent {
          min-height: 260px;
        }

        .galleryTrack {
          grid-auto-columns: 82%;
        }

        .contactGrid {
          grid-template-columns: 1fr;
        }
      }

      @media (max-width: 560px) {
        .wrap {
          width: min(var(--max), calc(100% - 20px));
          padding: 12px 0 44px;
        }

        .hero {
          padding: 16px;
          border-radius: 24px;
        }

        .logoPlate {
          padding: 16px;
          border-radius: 26px;
        }

        .kicker {
          font-size: 0.84rem;
        }

        h1 {
          font-size: clamp(1.8rem, 10vw, 2.35rem);
        }

        .subtitle {
          margin-top: 12px;
          font-size: 0.95rem;
        }

        .btn {
          min-height: 48px;
          padding: 12px 16px;
          font-size: 0.95rem;
        }

        .quick {
          grid-template-columns: repeat(4, 1fr);
          gap: 10px;
        }

        .qbtn {
          min-height: 80px;
          padding: 10px 8px;
          justify-content: center;
          text-align: center;
          flex-direction: column;
          gap: 8px;
        }

        .qtext {
          display: none;
        }

        .qicon {
          margin: 0;
          width: 44px;
          height: 44px;
        }

        .section {
          margin-top: 28px;
        }

        .card-media,
        .cardContent {
          min-height: 220px;
        }

        .cardContent {
          padding: 14px;
          gap: 8px;
        }

        .cardDesc {
          display: none;
        }

        .galleryTrack {
          grid-auto-columns: 88%;
          gap: 12px;
        }

        .quoteBox,
        .galleryShell {
          padding: 18px;
        }

        .accordion summary {
          padding: 16px;
          font-size: 0.96rem;
        }

        .accordionBody {
          padding: 0 16px 16px;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        [data-reveal],
        [data-reveal-child] {
          transition: none;
          opacity: 1;
          transform: none;
        }

        .btn,
        .qbtn,
        .galleryItem img,
        .card-media .cardBg img,
        .plus {
          transition: none !important;
        }

        .btn:hover,
        .qbtn:hover {
          transform: none;
        }
      }
    </style>
  </body>
</html>
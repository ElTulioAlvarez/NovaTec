  },
  {
    src: "/src/assets/microwebs/ponienteabogados/3.jpeg",
    alt: "Galería DEL PONIENTE & ABOGADOS 3",
  },
  {
    src: "/src/assets/microwebs/ponienteabogados/4.jpeg",
    alt: "Galería DEL PONIENTE & ABOGADOS 4",
  },
  {
    src: "/src/assets/microwebs/ponienteabogados/5.jpeg",

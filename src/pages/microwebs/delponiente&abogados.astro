        class="zoomBackdrop"
        type="button"
        data-close-zoom
        aria-label="Cerrar imagen"
      ></button>

      <div
        class="zoomDialog"
        role="dialog"
        aria-modal="true"
        aria-label="Vista ampliada de imagen"
      >
        <button
          class="zoomClose"
          type="button"
          data-close-zoom
          aria-label="Cerrar"
        >
          ×
        </button>
        <img id="zoomImage" src="" alt="" />
      </div>
    </div>

    <script>
      (() => {
        const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        const nodes = Array.from(
          document.querySelectorAll("[data-reveal]")
        );

        if (reduce) {
          nodes.forEach((el) => el.classList.add("is-in"));
        } else {
          const io = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (!entry.isIntersecting) return;

                const el = entry.target;
                el.classList.add("is-in");

                const kids = el.querySelectorAll(":scope > [data-reveal-child]");

                kids.forEach((kid, i) => {
                  kid.style.setProperty("--d", `${i * 55}ms`);
                });

                io.unobserve(el);
              });
            },
            { threshold: 0.18 }
          );

          nodes.forEach((el) => io.observe(el));
        }

        const modal = document.getElementById("zoomModal");
        const zoomImage = document.getElementById("zoomImage");

        const openButtons = Array.from(
          document.querySelectorAll("[data-open-zoom]")
        );

        const closeButtons = Array.from(
          document.querySelectorAll("[data-close-zoom]")
        );

        const openModal = (src, alt) => {
          if (!modal || !zoomImage) return;

          zoomImage.src = src;
          zoomImage.alt = alt || "";
          modal.classList.add("is-open");
          modal.setAttribute("aria-hidden", "false");
          document.body.style.overflow = "hidden";
        };

        const closeModal = () => {
          if (!modal || !zoomImage) return;

          modal.classList.remove("is-open");
          modal.setAttribute("aria-hidden", "true");
          zoomImage.src = "";
          zoomImage.alt = "";
          document.body.style.overflow = "";
        };

        openButtons.forEach((btn) => {
          btn.addEventListener("click", () => {
            const src = btn.getAttribute("data-src");
            const alt = btn.getAttribute("data-alt") ?? "";

            if (src) openModal(src, alt);
          });
        });

        closeButtons.forEach((btn) => {
          btn.addEventListener("click", closeModal);
        });

        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape") closeModal();
        });

        const copyBtn = document.querySelector("[data-copy-account]");
        const bankAccount = document.getElementById("bankAccount");

        copyBtn?.addEventListener("click", async () => {
          try {
            const text = bankAccount?.textContent?.trim() || "";
            await navigator.clipboard.writeText(text);
            copyBtn.textContent = "Copiado";

            window.setTimeout(() => {
              copyBtn.textContent = "Copiar";
            }, 1600);
          } catch {
            copyBtn.textContent = "No se pudo copiar";

            window.setTimeout(() => {
              copyBtn.textContent = "Copiar";
            }, 1800);
          }
        });

        const track = document.getElementById("galleryTrack");
        let isDown = false;
        let startX = 0;
        let scrollLeft = 0;

        if (track) {
          track.addEventListener("mousedown", (e) => {
            isDown = true;
            track.classList.add("dragging");
            startX = e.pageX - track.offsetLeft;
            scrollLeft = track.scrollLeft;
          });

          track.addEventListener("mouseleave", () => {
            isDown = false;
            track.classList.remove("dragging");
          });

          track.addEventListener("mouseup", () => {
            isDown = false;
            track.classList.remove("dragging");
          });

          track.addEventListener("mousemove", (e) => {
            if (!isDown) return;

            e.preventDefault();
            const x = e.pageX - track.offsetLeft;
            const walk = (x - startX) * 1.15;
            track.scrollLeft = scrollLeft - walk;
          });
        }
      })();
    </script>


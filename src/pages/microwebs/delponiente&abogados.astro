---
const PROFILE = {
  brand: "DEL PONIENTE & ABOGADOS",
  contact: "Lic. Iván Santos Cortés",
  phone: "5548563673",
  whatsapp: "5548563673",
  facebook:
    "https://www.facebook.com/profile.php?id=100079703094233&mibextid=wwXIfr&rdid=RYzz6odAyEBmLKeO&share_url=https%3A%2F%2Fwww.facebook.com%2Fshare%2F1DXfWdrvjn%2F%3Fmivextid%3DwwwXlfr#",
  instagram:
    "https://www.instagram.com/vicsantosco_del_poniente?igh=MXFkcDkzYmtmZz-BrYw%3D%3D&utm_-source=qr",
  bank: {

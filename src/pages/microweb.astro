---
/**
 * MicroWeb Tech Premium - 1 archivo .astro
 * NeoTec Business Solutions
 * Estética: tarjeta digital futurista / PCB / dashboard mobile
 *
 * Assets sugeridos en /public:
 * - /novatec-logo.webp
 * - /og-default.png
 * - /icons/phone.png
 * - /icons/whatsapp.png
 * - /icons/email.png
 * - /icons/maps.png
 * - /icons/facebook.png
 * - /icons/web.png
 */

const displayName = "NeoTec Business Solutions";
const brandTitle = "NeoTecMX";
const brandSubtitle = "Business Solutions";
const heroTagline = "Software · Web · POS · Social Media";

const heroImageUrl = "/web-app-manifest-512x512.png";

const contact = {
  phone: "+52 443 393 4469",
  phoneHref: "tel:+524433934469",
  whatsappHref:
    "https://wa.me/524433934469?text=Hola%20NeoTec%2C%20quisiera%20más%20información%20sobre%20sus%20servicios.",
  email: "noe.hdz@neotecmx.com",
  emailHref:
    "mailto:noe.hdz@neotecmx.com?subject=Contacto%20NeoTec%20Business%20Solutions",
  mapsHref: "https://www.google.com/maps?q=Morelia,+Michoac%C3%A1n",
  facebookHref: "https://www.facebook.com/search/top/?q=NeoTec%20Business%20Solutions",
  webHref: "https://neotecmx.com",
};

const quickLinks = [
  {
    label: "Llamar",
    href: contact.phoneHref,
    iconImg: "/icons/phone.png",
    accent: "cyan",
  },
  {
    label: "WhatsApp",
    href: contact.whatsappHref,
    iconImg: "/icons/whatsapp.png",
    accent: "green",
  },
  {
    label: "Email",
    href: contact.emailHref,
    iconImg: "/icons/email.png",
    accent: "blue",
  },
  {
    label: "Ubicación",
    href: contact.mapsHref,
    iconImg: "/icons/maps.png",
    accent: "yellow",
  },
  {
    label: "Facebook",
    href: contact.facebookHref,
    iconImg: "/icons/facebook.png",
    accent: "indigo",
  },
  {
    label: "Web",
    href: contact.webHref,
    iconImg: "/icons/web.png",
    accent: "slate",
  },
];

const services = [
  {
    code: "DEV",
    title: "Software a medida",
    body: "Sistemas web, escritorio y herramientas internas para controlar operación, ventas, inventario y procesos clave.",
  },
  {
    code: "POS",
    title: "Punto de venta",
    body: "Implementación y personalización de POS: ventas, caja, inventario, reportes, usuarios y multi-sucursal.",
  },
  {
    code: "WEB",
    title: "Páginas web y MicroWebs",
    body: "Sitios profesionales, landing pages y tarjetas digitales optimizadas para presencia, contacto y captación de clientes.",
  },
  {
    code: "MKT",
    title: "Social media",
    body: "Gestión de redes, contenido, campañas y estrategia digital para negocios que quieren verse profesionales y vender mejor.",
  },
];

const stats = [
  {
    value: "360°",
    label: "Soluciones integrales",
  },
  {
    value: "B2B",
    label: "Enfoque empresarial",
  },
  {
    value: "MX",
    label: "Talento mexicano",
  },
];

const primaryCtaText = "Cotizar por WhatsApp";
const primaryCtaHref =
  "https://wa.me/524433934469?text=Hola%20NeoTec%2C%20quiero%20cotizar%20un%20proyecto%20por%20favor.";

const gallery = [
  {
    title: "Software",
    text: "Sistemas diseñados para operar mejor.",
    img: "https://images.unsplash.com/photo-1551288049-bebda4e38f71?auto=format&fit=crop&w=1200&q=80",
  },
  {
    title: "Punto de venta",
    text: "Control de ventas, caja e inventario.",
    img: "https://images.unsplash.com/photo-1556742049-0cfed4f6a45d?auto=format&fit=crop&w=1200&q=80",
  },
  {
    title: "Marketing digital",
    text: "Presencia profesional para tu negocio.",
    img: "https://images.unsplash.com/photo-1557838923-2985c318be48?auto=format&fit=crop&w=1200&q=80",
  },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{displayName}</title>

    <meta
      name="description"
      content="NeoTec Business Solutions - Software, POS, páginas web, MicroWebs y social media para negocios."
    />

    <meta name="theme-color" content="#020617" />
  </head>

  <body>
    <div class="page">
      <div class="shell">

        <!-- HERO -->
        <section class="hero" aria-label="Presentación NeoTec">
          <div class="topbar">
            <div class="brand-lockup">
              <div class="brand-logo">
                <img src={heroImageUrl} alt="NeoTec Business Solutions" loading="eager" />
              </div>

              <div class="brand-name">
                <strong>{brandTitle}</strong>
                <span>{brandSubtitle}</span>
              </div>
            </div>

            <div class="status-pill">
              <span class="status-dot" aria-hidden="true"></span>
              Disponible
            </div>
          </div>

          <div class="hero-main">
            <div>
              <span class="eyebrow">{heroTagline}</span>

              <h1 class="title">
                Soluciones
                <span>digitales</span>
              </h1>

              <p class="subtitle">
                Desarrollamos tecnología, sitios web, sistemas POS y presencia
                digital para que tu negocio opere mejor, venda más y se vea
                profesional desde el primer contacto.
              </p>
            </div>

            <div class="hero-panel">
              <div class="terminal">
                <div class="terminal-head">
                  <div class="traffic" aria-hidden="true">
                    <span></span>
                    <span></span>
                    <span></span>
                  </div>
                  <small>neotec://business-solutions</small>
                </div>

                <div class="terminal-body">
                  <p><span>$</span> diagnosticar_negocio</p>
                  <p><span>✓</span> procesos · ventas · inventario · presencia</p>
                  <p><span>$</span> construir_solucion --lista-para-operar</p>
                </div>
              </div>
            </div>

            <div class="stats">
              {
                stats.map((stat) => (
                  <div class="stat">
                    <strong>{stat.value}</strong>
                    <span>{stat.label}</span>
                  </div>
                ))
              }
            </div>

            <div class="primary-actions">
              <a class="primary-btn" href={primaryCtaHref} target="_blank" rel="noopener">
                {primaryCtaText}
                <span aria-hidden="true">→</span>
              </a>

              <a class="secondary-btn" href={contact.webHref} target="_blank" rel="noopener">
                Visitar sitio web
              </a>
            </div>
          </div>
        </section>

        <!-- QUICK LINKS -->
        <section class="quick-section" aria-label="Accesos rápidos">
          <div class="section-title">
            <h2>Contacto directo</h2>
            <span>1 toque</span>
          </div>

          <div class="quick-grid">
            {
              quickLinks.map((link) => (
                <a
                  class={`quick-link accent-${link.accent}`}
                  href={link.href}
                  target={link.href.startsWith("http") ? "_blank" : undefined}
                  rel={link.href.startsWith("http") ? "noopener noreferrer" : undefined}
                  aria-label={link.label}
                >
                  <div class="quick-icon">
                    <img src={link.iconImg} alt="" loading="lazy" />
                  </div>
                  <strong>{link.label}</strong>
                </a>
              ))
            }
          </div>
        </section>

        <!-- SERVICES -->
        <section class="services-section" aria-label="Servicios">
          <div class="section-title">
            <h2>Servicios</h2>
            <span>NeoTec Stack</span>
          </div>

          <div class="service-list">
            {
              services.map((service, index) => (
                <details class="service-card" {...(index === 0 ? { open: true } : {})}>
                  <summary>
                    <span class="service-left">
                      <span class="service-code">{service.code}</span>
                      <span class="service-name">
                        <strong>{service.title}</strong>
                        <span>Solución profesional</span>
                      </span>
                    </span>

                    <span class="plus">+</span>
                  </summary>

                  <div class="service-body">
                    {service.body}
                  </div>
                </details>
              ))
            }
          </div>
        </section>

        <!-- GALLERY -->
        <section class="gallery-section" aria-label="Galería de soluciones">
          <div class="section-title">
            <h2>Aplicaciones</h2>
            <span>Casos de uso</span>
          </div>

          <div class="gallery-track">
            {
              gallery.map((item) => (
                <article class="gallery-card">
                  <img src={item.img} alt={item.title} loading="lazy" />
                  <div class="gallery-content">
                    <strong>{item.title}</strong>
                    <span>{item.text}</span>
                  </div>
                </article>
              ))
            }
          </div>
        </section>

        <!-- CTA -->
        <section class="cta-section" aria-label="Cotización">
          <div class="cta-card">
            <h2>¿Listo para profesionalizar tu negocio?</h2>
            <p>
              Escríbenos por WhatsApp y cuéntanos qué necesitas: software,
              página web, POS, MicroWeb o presencia digital.
            </p>

            <a class="primary-btn" href={primaryCtaHref} target="_blank" rel="noopener">
              Iniciar cotización
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </section>

        <footer class="footer">
          <strong>{displayName}</strong><br />
          Morelia, Michoacán · México<br />
          {contact.phone} · {contact.email}
        </footer>
      </div>
    </div>
  </body>
</html>

<style>
      :root {
        --bg: #020617;
        --bg-soft: #061426;
        --panel: rgba(15, 23, 42, 0.72);
        --panel-strong: rgba(15, 23, 42, 0.92);
        --line: rgba(125, 211, 252, 0.24);
        --line-soft: rgba(148, 163, 184, 0.16);
        --text: #e5e7eb;
        --muted: #94a3b8;
        --muted-2: #64748b;
        --cyan: 103, 232, 249;
        --cyan-strong: #22d3ee;
        --blue: 59, 130, 246;
        --green: 34, 197, 94;
        --yellow: 234, 179, 8;
        --indigo: 99, 102, 241;
        --slate: 148, 163, 184;
        --radius: 28px;
        --radius-card: 22px;
        --max: 560px;
        --shadow: 0 30px 90px rgba(0, 0, 0, 0.55);
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        min-height: 100%;
      }

      body {
        margin: 0;
        min-height: 100svh;
        display: flex;
        justify-content: center;
        color: var(--text);
        font-family:
          Inter,
          ui-sans-serif,
          system-ui,
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          Roboto,
          Arial,
          sans-serif;
        background:
          radial-gradient(circle at 15% 0%, rgba(var(--cyan), 0.18), transparent 34%),
          radial-gradient(circle at 90% 12%, rgba(var(--blue), 0.16), transparent 34%),
          radial-gradient(circle at 55% 100%, rgba(var(--indigo), 0.12), transparent 34%),
          linear-gradient(180deg, #020617 0%, #061426 46%, #020617 100%);
        overflow-x: hidden;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      .page {
        width: 100%;
        max-width: var(--max);
        padding: 14px 12px 28px;
      }

      @media (min-width: 760px) {
        body {
          padding-block: 24px;
        }

        .page {
          max-width: 620px;
        }
      }

      .shell {
        position: relative;
        overflow: hidden;
        border-radius: var(--radius);
        border: 1px solid rgba(125, 211, 252, 0.24);
        background:
          linear-gradient(180deg, rgba(15, 23, 42, 0.82), rgba(2, 6, 23, 0.92)),
          var(--bg);
        box-shadow: var(--shadow);
        isolation: isolate;
      }

      .shell::before {
        content: "";
        position: absolute;
        inset: 0;
        z-index: -2;
        background:
          radial-gradient(circle at 20% 0%, rgba(var(--cyan), 0.22), transparent 32%),
          radial-gradient(circle at 100% 28%, rgba(var(--blue), 0.14), transparent 36%),
          linear-gradient(180deg, rgba(255, 255, 255, 0.045), transparent 28%);
      }

      .shell::after {
        content: "";
        position: absolute;
        inset: 0;
        z-index: -1;
        opacity: 0.42;
        background-image:
          linear-gradient(rgba(125, 211, 252, 0.07) 1px, transparent 1px),
          linear-gradient(90deg, rgba(125, 211, 252, 0.07) 1px, transparent 1px);
        background-size: 42px 42px;
        mask-image: radial-gradient(circle at 50% 18%, black 0%, transparent 72%);
        pointer-events: none;
      }

      /* =========================
         PCB decorativo
      ========================== */

      .pcb {
        position: absolute;
        inset: 0;
        z-index: -1;
        opacity: 0.32;
        pointer-events: none;
      }

      .pcb svg {
        width: 100%;
        height: 100%;
        display: block;
      }

      /* =========================
         Hero
      ========================== */

      .hero {
        position: relative;
        min-height: 100svh;
        display: flex;
        flex-direction: column;
        padding: 20px 16px 16px;
      }

      .topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
      }

      .brand-lockup {
        display: flex;
        align-items: center;
        gap: 12px;
      }

      .brand-logo {
        position: relative;
        display: grid;
        place-items: center;
        width: 54px;
        height: 54px;
        border-radius: 18px;
        border: 1px solid rgba(125, 211, 252, 0.34);
        background:
          radial-gradient(circle at 30% 15%, rgba(103, 232, 249, 0.24), transparent 40%),
          rgba(2, 6, 23, 0.62);
        box-shadow:
          0 16px 34px rgba(14, 165, 233, 0.18),
          inset 0 0 0 1px rgba(255, 255, 255, 0.06);
        overflow: hidden;
      }

      .brand-logo img {
        width: 38px;
        height: 38px;
        object-fit: contain;
      }

      .brand-name {
        display: grid;
        gap: 1px;
      }

      .brand-name strong {
        font-size: 1.05rem;
        line-height: 1;
        font-weight: 950;
        letter-spacing: -0.03em;
      }

      .brand-name span {
        font-size: 0.68rem;
        font-weight: 800;
        letter-spacing: 0.25em;
        text-transform: uppercase;
        color: rgba(148, 163, 184, 0.92);
      }

      .status-pill {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        border-radius: 999px;
        border: 1px solid rgba(34, 197, 94, 0.24);
        background: rgba(34, 197, 94, 0.08);
        padding: 8px 10px;
        font-size: 0.72rem;
        font-weight: 850;
        color: rgba(187, 247, 208, 0.96);
        white-space: nowrap;
      }

      .status-dot {
        width: 7px;
        height: 7px;
        border-radius: 99px;
        background: #22c55e;
        box-shadow: 0 0 18px rgba(34, 197, 94, 0.7);
      }

      .hero-main {
        flex: 1;
        display: grid;
        align-content: center;
        gap: 20px;
        padding-block: 26px 18px;
      }

      .eyebrow {
        display: inline-flex;
        width: fit-content;
        align-items: center;
        gap: 8px;
        border-radius: 999px;
        border: 1px solid rgba(125, 211, 252, 0.26);
        background: rgba(125, 211, 252, 0.08);
        padding: 8px 11px;
        color: rgba(207, 250, 254, 0.95);
        font-size: 0.75rem;
        font-weight: 850;
        letter-spacing: 0.04em;
      }

      .eyebrow::before {
        content: "";
        width: 8px;
        height: 8px;
        border-radius: 99px;
        background: #67e8f9;
        box-shadow: 0 0 18px rgba(103, 232, 249, 0.7);
      }

      .title {
        margin: 0;
        max-width: 11ch;
        font-size: clamp(3rem, 11vw, 5rem);
        line-height: 0.86;
        font-weight: 1000;
        letter-spacing: -0.075em;
        color: #f8fafc;
        text-transform: uppercase;
        text-shadow: 0 24px 64px rgba(0, 0, 0, 0.45);
      }

      .title span {
        display: block;
        color: #67e8f9;
      }

      .subtitle {
        margin: 0;
        max-width: 34rem;
        color: rgba(226, 232, 240, 0.88);
        font-size: 1.02rem;
        line-height: 1.72;
      }

      .hero-panel {
        position: relative;
        overflow: hidden;
        border-radius: 24px;
        border: 1px solid rgba(125, 211, 252, 0.22);
        background:
          radial-gradient(circle at 15% 0%, rgba(103, 232, 249, 0.14), transparent 38%),
          linear-gradient(135deg, rgba(15, 23, 42, 0.78), rgba(2, 6, 23, 0.72));
        padding: 14px;
        box-shadow:
          0 22px 56px rgba(0, 0, 0, 0.38),
          inset 0 0 0 1px rgba(255, 255, 255, 0.045);
        backdrop-filter: blur(14px);
      }

      .hero-panel::after {
        content: "";
        position: absolute;
        inset: 0;
        background:
          linear-gradient(115deg, rgba(255, 255, 255, 0.09), transparent 26%, transparent 70%, rgba(103, 232, 249, 0.08)),
          repeating-linear-gradient(
            0deg,
            rgba(255, 255, 255, 0.03) 0px,
            rgba(255, 255, 255, 0.03) 1px,
            transparent 1px,
            transparent 9px
          );
        opacity: 0.22;
        mix-blend-mode: overlay;
        pointer-events: none;
      }

      .terminal {
        position: relative;
        z-index: 1;
        overflow: hidden;
        border-radius: 18px;
        border: 1px solid rgba(148, 163, 184, 0.18);
        background: rgba(2, 6, 23, 0.7);
      }

      .terminal-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 11px 12px;
        border-bottom: 1px solid rgba(148, 163, 184, 0.16);
      }

      .traffic {
        display: flex;
        gap: 6px;
      }

      .traffic span {
        width: 9px;
        height: 9px;
        border-radius: 99px;
        background: rgba(103, 232, 249, 0.45);
      }

      .traffic span:nth-child(2) {
        background: rgba(59, 130, 246, 0.45);
      }

      .traffic span:nth-child(3) {
        background: rgba(34, 197, 94, 0.45);
      }

      .terminal-head small {
        color: rgba(148, 163, 184, 0.84);
        font-weight: 800;
        font-size: 0.72rem;
        letter-spacing: 0.06em;
      }

      .terminal-body {
        padding: 14px;
        display: grid;
        gap: 8px;
        font-family:
          ui-monospace,
          SFMono-Regular,
          Menlo,
          Monaco,
          Consolas,
          monospace;
        font-size: 0.82rem;
        color: rgba(226, 232, 240, 0.92);
      }

      .terminal-body p {
        margin: 0;
      }

      .terminal-body span {
        color: #67e8f9;
      }

      .stats {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 10px;
      }

      .stat {
        border-radius: 18px;
        border: 1px solid rgba(148, 163, 184, 0.16);
        background: rgba(15, 23, 42, 0.66);
        padding: 12px 10px;
        text-align: center;
        box-shadow:
          0 14px 32px rgba(0, 0, 0, 0.26),
          inset 0 0 0 1px rgba(255, 255, 255, 0.035);
      }

      .stat strong {
        display: block;
        font-size: 1.2rem;
        font-weight: 950;
        color: #67e8f9;
      }

      .stat span {
        display: block;
        margin-top: 3px;
        font-size: 0.68rem;
        line-height: 1.25;
        color: rgba(203, 213, 225, 0.76);
      }

      .primary-actions {
        display: grid;
        grid-template-columns: 1fr;
        gap: 10px;
      }

      .primary-btn,
      .secondary-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        min-height: 54px;
        border-radius: 18px;
        font-weight: 950;
        letter-spacing: -0.01em;
        transition:
          transform 0.12s ease,
          filter 0.2s ease,
          box-shadow 0.2s ease;
      }

      .primary-btn {
        background: linear-gradient(135deg, #67e8f9, #22d3ee);
        color: #020617;
        box-shadow: 0 18px 44px rgba(34, 211, 238, 0.28);
      }

      .secondary-btn {
        border: 1px solid rgba(148, 163, 184, 0.22);
        background: rgba(15, 23, 42, 0.72);
        color: rgba(248, 250, 252, 0.94);
        box-shadow:
          0 14px 32px rgba(0, 0, 0, 0.24),
          inset 0 0 0 1px rgba(255, 255, 255, 0.035);
      }

      .primary-btn:hover,
      .secondary-btn:hover {
        transform: translateY(-1px);
        filter: brightness(1.04);
      }

      .primary-btn:active,
      .secondary-btn:active {
        transform: translateY(1px);
      }

      /* =========================
         Quick links
      ========================== */

      .quick-section {
        padding: 16px;
        border-top: 1px solid rgba(148, 163, 184, 0.14);
        background:
          radial-gradient(circle at 50% 0%, rgba(103, 232, 249, 0.12), transparent 42%),
          rgba(2, 6, 23, 0.32);
      }

      .section-title {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 12px;
      }

      .section-title h2 {
        margin: 0;
        font-size: 0.86rem;
        font-weight: 950;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: rgba(226, 232, 240, 0.9);
      }

      .section-title span {
        font-size: 0.75rem;
        color: rgba(148, 163, 184, 0.8);
      }

      .quick-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 12px;
      }

      .quick-link {
        display: grid;
        gap: 8px;
        justify-items: center;
        border-radius: 20px;
        border: 1px solid rgba(148, 163, 184, 0.16);
        background:
          linear-gradient(135deg, rgba(15, 23, 42, 0.82), rgba(2, 6, 23, 0.68));
        padding: 12px 8px;
        box-shadow:
          0 16px 34px rgba(0, 0, 0, 0.26),
          inset 0 0 0 1px rgba(255, 255, 255, 0.035);
        -webkit-tap-highlight-color: transparent;
      }

      .quick-icon {
        display: grid;
        place-items: center;
        width: 54px;
        height: 54px;
        border-radius: 18px;
        background: rgba(2, 6, 23, 0.68);
        border: 1px solid rgba(255, 255, 255, 0.1);
        position: relative;
        overflow: hidden;
      }

      .quick-icon::after {

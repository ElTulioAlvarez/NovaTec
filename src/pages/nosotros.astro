---
import Navbar from "../componentes/navbar.astro";
import Footer from "../componentes/footer.astro";
import SEO from "../componentes/seo.astro";
import CircuitBG from "../componentes/CircuitBG.astro";
import "../styles/global.css";

const title = "Nosotros — NeoTec Business Solutions";
const description =
  "NeoTec Business Solutions es una empresa tecnológica mexicana que desarrolla software, páginas web, soluciones POS, automatización y estrategias digitales para profesionalizar negocios.";

const icons = {
  check: `<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor"><path d="M9 16.17 4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17Z"/></svg>`,

  rocket: `<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor"><path d="M12.8 3.2c2.9-.9 6-.6 7.8.1.7 1.8 1 4.9.1 7.8-.9 3-3 5.8-6.5 8.4l-.9-4.2-4.6-4.6-4.2-.9c2.5-3.6 5.3-5.7 8.3-6.6Zm2.6 5.4a2 2 0 1 0 2.8 2.8 2 2 0 0 0-2.8-2.8ZM5.2 14.5l4.3 4.3-5.2 1.7a.7.7 0 0 1-.8-.9l1.7-5.1Z"/></svg>`,

  code: `<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor"><path d="M9.4 16.6 4.8 12l4.6-4.6L8 6l-6 6 6 6 1.4-1.4Zm5.2 0L19.2 12l-4.6-4.6L16 6l6 6-6 6-1.4-1.4ZM13.2 4 9.5 20h2.1L15.3 4h-2.1Z"/></svg>`,

  media: `<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor"><path d="M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Zm1 3v10h14V7H5Zm4 2 6 3-6 3V9Z"/></svg>`,

  pos: `<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor"><path d="M5 3h14a2 2 0 0 1 2 2v9H3V5a2 2 0 0 1 2-2Zm0 3v5h14V6H5Zm-2 10h18v2a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-2Zm5 1v2h8v-2H8Z"/></svg>`,

  strategy: `<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2 4 6v6c0 5 3.4 9.7 8 10 4.6-.3 8-5 8-10V6l-8-4Zm1 5v5.6l4 2.4-1 1.7-5-3V7h2Z"/></svg>`,

  people: `<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor"><path d="M12 12a5 5 0 1 0-5-5 5 5 0 0 0 5 5Zm0 2c-4.4 0-8 2.2-8 5v1h16v-1c0-2.8-3.6-5-8-5Zm7-2a4 4 0 1 0-3.4-6.1A6.9 6.9 0 0 1 17 10c0 .7-.1 1.3-.3 1.9.7.1 1.5.1 2.3.1Zm0 2c-.8 0-1.6-.1-2.4-.3 1.5 1.1 2.4 2.5 2.4 4.3v1h4v-1c0-2.2-2.7-4-4-4ZM5 12c.8 0 1.6 0 2.3-.2A6.6 6.6 0 0 1 7 10c0-1.5.5-3 1.4-4.1A4 4 0 1 0 5 12Zm0 2c-1.3 0-4 1.8-4 4v1h4v-1c0-1.8.9-3.2 2.4-4.3-.8.2-1.6.3-2.4.3Z"/></svg>`,

  flow: `<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor"><path d="M7 3h10v5H7V3ZM4 11h7v5H4v-5Zm9 5h7v5h-7v-5Zm-2-3h2v2h-2v-2Zm1-5h2v3h-2V8Z"/></svg>`,

  shield: `<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2 4 5v6c0 5.5 3.4 10.2 8 11 4.6-.8 8-5.5 8-11V5l-8-3Zm-1 14.5-4-4L8.4 11l2.6 2.6L16.6 8 18 9.4l-7 7.1Z"/></svg>`,

  spark: `<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2 14.2 8H21l-5.5 4 2.2 6.5L12 14.5 6.3 18.5 8.5 12 3 8h6.8L12 2Z"/></svg>`,
};

const pillars = [
  {
    icon: icons.code,
    title: "Tecnología útil",
    text: "Desarrollamos sistemas, plataformas y herramientas que resuelven problemas reales de operación.",
  },
  {
    icon: icons.strategy,
    title: "Estrategia clara",
    text: "Antes de construir, entendemos el negocio, los procesos, el usuario y el objetivo comercial.",
  },
  {
    icon: icons.shield,
    title: "Implementación seria",
    text: "No entregamos solo archivos: acompañamos con configuración, capacitación, soporte y mejora continua.",
  },
];

const services = [
  "Software a medida",
  "Páginas web profesionales",
  "Sistemas POS",
  "Automatización de procesos",
  "E-commerce",
  "Social media",
  "Branding digital",
  "Soporte y capacitación",
];

const process = [
  {
    title: "Diagnóstico",
    text: "Escuchamos la necesidad, revisamos el contexto y detectamos fricciones operativas o comerciales.",
  },
  {
    title: "Propuesta",
    text: "Definimos alcance, entregables, tiempos, prioridades y ruta de implementación.",
  },
  {
    title: "Desarrollo",
    text: "Construimos la solución con enfoque funcional, visual y técnico según el objetivo del proyecto.",
  },
  {
    title: "Implementación",
    text: "Configuramos, probamos, capacitamos y dejamos una base lista para operar.",
  },
];

const stats = [
  {
    value: "360°",
    label: "Visión integral",
  },
  {
    value: "B2B",
    label: "Enfoque empresarial",
  },
  {
    value: "MX",
    label: "Talento mexicano",
  },
];
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <SEO
      title={title}
      description={description}
      type="website"
      locale="es_MX"
    />

    <title>{title}</title>
  </head>

  <body
    class="min-h-screen bg-slate-950 text-slate-100 selection:bg-cyan-500/30 selection:text-white"
  >
    <Navbar logoSrc="/novatec-logo.webp" />
    <CircuitBG opacity={0.24} />

    <main class="relative z-10 overflow-x-clip">
      <!-- HERO -->
      <header class="relative pt-28 pb-14 sm:pt-32 sm:pb-20 lg:pt-40 lg:pb-28">
        <section class="mx-auto w-full max-w-7xl px-5 sm:px-6 lg:px-8">
          <div class="about-hero-grid">
            <div class="about-hero-copy">
              <span class="section-pill">
                Acerca de NeoTec
              </span>

              <h1 class="about-title">
                Tecnología, estrategia y ejecución para negocios que quieren crecer
              </h1>

              <p class="about-lead">
                En <strong>NeoTec Business Solutions</strong> ayudamos a empresas,
                comercios y emprendedores a profesionalizar su operación mediante
                software, presencia digital, automatización y soluciones tecnológicas
                diseñadas para trabajar en el mundo real.
              </p>

              <p class="about-text">
                Nuestro enfoque no es vender tecnología por venderla. Primero
                entendemos el negocio, luego diseñamos una solución viable y
                finalmente acompañamos la implementación para que realmente genere
                valor.
              </p>

              <div class="about-actions">
                <a href="/cotizar" class="btn-primary">
                  Cotizar proyecto
                  <span aria-hidden="true">→</span>
                </a>

                <a href="/servicios" class="btn-ghost">
                  Ver soluciones
                </a>
              </div>
            </div>

            <aside class="about-hero-panel">
              <div class="panel-glow"></div>

              <div class="company-card">
                <div class="company-card-header">
                  <span class="company-icon" set:html={icons.rocket}></span>

                  <div>
                    <span class="company-kicker">NeoTecMX</span>
                    <h2>Business Solutions</h2>
                  </div>
                </div>

                <p>
                  Integramos desarrollo, diseño, infraestructura, marketing y
                  soporte para entregar soluciones completas, medibles y listas
                  para operar.
                </p>

                <div class="company-tags">
                  <span>Software</span>
                  <span>Web</span>
                  <span>POS</span>
                  <span>Social Media</span>
                </div>
              </div>

              <div class="stats-grid">
                {
                  stats.map((stat) => (
                    <div class="stat-card">
                      <strong>{stat.value}</strong>
                      <span>{stat.label}</span>
                    </div>
                  ))
                }
              </div>
            </aside>
          </div>
        </section>
      </header>

      <!-- QUÉ HACEMOS -->
      <section class="section-space">
        <div class="mx-auto max-w-7xl px-5 sm:px-6 lg:px-8">
          <div class="section-heading">
            <span class="section-pill">
              Qué hacemos
            </span>

            <h2>Convertimos necesidades de negocio en soluciones funcionales</h2>

            <p>
              Diseñamos e implementamos herramientas digitales que ayudan a
              vender mejor, administrar con más control y proyectar una imagen
              profesional.
            </p>
          </div>

          <div class="pill-grid">
            {
              services.map((item) => (
                <div class="solution-pill">
                  <span set:html={icons.check}></span>
                  <span>{item}</span>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <!-- PILARES -->
      <section class="section-space pt-0">
        <div class="mx-auto max-w-7xl px-5 sm:px-6 lg:px-8">
          <div class="grid gap-6 lg:grid-cols-3">
            {
              pillars.map((pillar) => (
                <article class="neo-card">
                  <div class="neo-card-icon" set:html={pillar.icon}></div>
                  <h3>{pillar.title}</h3>
                  <p>{pillar.text}</p>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <!-- HISTORIA / ENFOQUE -->
      <section class="section-space">
        <div class="mx-auto max-w-7xl px-5 sm:px-6 lg:px-8">
          <div class="story-card">
            <div class="story-content">
              <span class="section-pill">
                Nuestra forma de trabajar
              </span>

              <h2>
                No construimos adornos digitales. Construimos herramientas para operar mejor.
              </h2>

              <p>
                Muchos negocios tienen procesos valiosos, pero desordenados:
                ventas registradas a medias, inventarios inconsistentes,
                comunicación dispersa, redes sociales sin estrategia o sistemas
                que ya se quedaron cortos. Ahí entra NeoTec.
              </p>

              <p>
                Nuestro trabajo es convertir ese caos en una solución clara:
                sistemas que dan trazabilidad, sitios que transmiten confianza,
                campañas que comunican valor y herramientas que ayudan a tomar
                mejores decisiones.
              </p>
            </div>

            <div class="story-aside">
              <div class="mini-terminal">
                <div class="terminal-top">
                  <span></span>
                  <span></span>
                  <span></span>
                </div>

                <div class="terminal-lines">
                  <p><span>01</span> Diagnosticar operación</p>
                  <p><span>02</span> Diseñar solución viable</p>
                  <p><span>03</span> Implementar con soporte</p>
                  <p><span>04</span> Medir, ajustar y escalar</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- PROCESO -->
      <section class="section-space">
        <div class="mx-auto max-w-7xl px-5 sm:px-6 lg:px-8">
          <div class="section-heading">
            <span class="section-pill">
              Proceso
            </span>

            <h2>De la idea a una solución lista para operar</h2>

            <p>
              Trabajamos por etapas para reducir improvisación, ordenar prioridades
              y entregar soluciones que sí puedan usarse en operación diaria.
            </p>
          </div>

          <div class="process-grid">
            {
              process.map((step, index) => (
                <article class="process-card">
                  <span class="process-number">
                    {String(index + 1).padStart(2, "0")}
                  </span>

                  <h3>{step.title}</h3>
                  <p>{step.text}</p>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <!-- VALORES / DIFERENCIADORES -->
      <section class="section-space">
        <div class="mx-auto max-w-7xl px-5 sm:px-6 lg:px-8">
          <div class="values-grid">
            <article class="values-main">
              <span class="section-pill">
                Por qué elegirnos
              </span>

              <h2>Porque una solución bonita no sirve si no resuelve nada</h2>

              <p>
                Nos importa el diseño, claro. Pero nos importa más que el sistema
                funcione, que el cliente entienda cómo usarlo, que el negocio
                gane control y que cada entrega tenga una razón estratégica.
              </p>
            </article>

            <div class="values-list">
              <div class="value-item">
                <span set:html={icons.check}></span>
                <div>
                  <h3>Claridad antes que humo</h3>
                  <p>Alcances, costos, tiempos y entregables bien definidos.</p>
                </div>
              </div>

              <div class="value-item">
                <span set:html={icons.check}></span>
                <div>
                  <h3>Soluciones escalables</h3>
                  <p>Pensadas para crecer con el negocio, no para estorbar en tres meses.</p>
                </div>
              </div>

              <div class="value-item">
                <span set:html={icons.check}></span>
                <div>
                  <h3>Acompañamiento real</h3>
                  <p>Implementación, capacitación y soporte para que la solución no se quede de adorno.</p>
                </div>
              </div>

              <div class="value-item">
                <span set:html={icons.check}></span>
                <div>
                  <h3>Visión técnica y comercial</h3>
                  <p>Unimos desarrollo, operación y comunicación para resolver con más contexto.</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- CTA FINAL -->
      <section class="section-space">
        <div class="mx-auto max-w-7xl px-5 sm:px-6 lg:px-8">
          <div class="final-cta">
            <div>
              <span class="section-pill">
                Siguiente paso
              </span>

              <h2>Cuéntanos qué necesita tu negocio</h2>

              <p>
                Podemos ayudarte a aterrizar la idea, definir el alcance y crear
                una propuesta clara para tu proyecto.
              </p>
            </div>

            <a href="/cotizar" class="btn-primary">
              Solicitar cotización
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </section>
    </main>

    <Footer logoSrc="/novatec-logo.webp" />

    
  </body>
</html>
<style is:global>
      .section-space {
        padding-top: 3.5rem;
        padding-bottom: 3.5rem;
      }

      @media (min-width: 640px) {
        .section-space {
          padding-top: 4.5rem;
          padding-bottom: 4.5rem;
        }
      }

      @media (min-width: 1024px) {
        .section-space {
          padding-top: 5.75rem;
          padding-bottom: 5.75rem;
        }
      }

      .section-pill {
        display: inline-flex;
        width: fit-content;
        align-items: center;
        border-radius: 9999px;
        border: 1px solid rgba(103, 232, 249, 0.28);
        background: rgba(103, 232, 249, 0.09);
        padding: 0.38rem 0.8rem;
        font-size: 0.76rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        color: rgba(207, 250, 254, 0.94);
      }

      .section-heading {
        max-width: 52rem;
        margin-bottom: 2rem;
      }

      .section-heading h2 {
        margin-top: 1rem;
        font-size: clamp(1.55rem, 1.2vw + 1rem, 2.35rem);
        font-weight: 900;
        line-height: 1.15;
        letter-spacing: -0.035em;
        color: rgba(248, 250, 252, 0.98);
      }

      .section-heading p {
        margin-top: 0.85rem;
        max-width: 48rem;
        font-size: 1rem;
        line-height: 1.75;
        color: rgba(203, 213, 225, 0.88);
      }

      .btn-primary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.55rem;
        border-radius: 0.95rem;
        background: linear-gradient(135deg, #67e8f9, #22d3ee);
        padding: 0.95rem 1.7rem;
        font-weight: 900;
        color: #020617;
        box-shadow: 0 14px 32px rgba(34, 211, 238, 0.22);
        transition:
          transform 0.12s ease,
          box-shadow 0.2s ease,
          filter 0.2s ease;
      }

      .btn-primary:hover {
        filter: brightness(1.05);
        transform: translateY(-1px);
        box-shadow: 0 18px 42px rgba(34, 211, 238, 0.3);
      }

      .btn-primary:active {
        transform: translateY(1px);
      }

      .btn-ghost {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.55rem;
        border-radius: 0.95rem;
        border: 1px solid rgba(148, 163, 184, 0.24);
        background: rgba(15, 23, 42, 0.68);
        padding: 0.95rem 1.7rem;
        font-weight: 850;
        color: rgba(248, 250, 252, 0.96);
        box-shadow:
          inset 0 0 0 1px rgba(255, 255, 255, 0.035),
          0 12px 28px rgba(0, 0, 0, 0.22);
        transition:
          background 0.2s ease,
          border-color 0.2s ease,
          transform 0.12s ease;
      }

      .btn-ghost:hover {
        border-color: rgba(103, 232, 249, 0.34);
        background: rgba(15, 23, 42, 0.86);
        transform: translateY(-1px);
      }

      .about-hero-grid {
        display: grid;
        gap: 2.25rem;
        align-items: center;
      }

      @media (min-width: 1024px) {
        .about-hero-grid {
          grid-template-columns: 1.08fr 0.92fr;
          gap: 4.5rem;
        }
      }

      .about-hero-copy {
        max-width: 52rem;
      }

      .about-title {
        margin-top: 1.25rem;
        font-size: clamp(2rem, 3vw + 1rem, 4.3rem);
        font-weight: 950;
        line-height: 1.03;
        letter-spacing: -0.055em;
        color: rgba(248, 250, 252, 0.98);
        text-shadow: 0 18px 54px rgba(0, 0, 0, 0.34);
      }

      .about-lead {
        margin-top: 1.35rem;
        max-width: 46rem;
        font-size: clamp(1rem, 0.25vw + 1rem, 1.18rem);
        line-height: 1.78;
        color: rgba(226, 232, 240, 0.92);
      }

      .about-text {
        margin-top: 1rem;
        max-width: 44rem;
        font-size: 0.98rem;
        line-height: 1.75;
        color: rgba(203, 213, 225, 0.84);
      }

      .about-actions {
        margin-top: 1.8rem;
        display: flex;
        flex-direction: column;
        gap: 0.85rem;
      }

      @media (min-width: 640px) {
        .about-actions {
          flex-direction: row;
          align-items: center;
        }
      }

      .about-hero-panel {
        position: relative;
        display: grid;
        gap: 1rem;
      }

      .panel-glow {
        position: absolute;
        inset: -2.5rem;
        z-index: -1;
        border-radius: 2rem;
        background:
          radial-gradient(circle at 30% 20%, rgba(34, 211, 238, 0.22), transparent 34%),
          radial-gradient(circle at 80% 70%, rgba(168, 85, 247, 0.14), transparent 42%);
        filter: blur(32px);
        opacity: 0.82;
        pointer-events: none;
      }

      .company-card {
        position: relative;
        overflow: hidden;
        border-radius: 1.45rem;
        border: 1px solid rgba(125, 211, 252, 0.28);
        background:
          radial-gradient(circle at 18% 12%, rgba(34, 211, 238, 0.16), transparent 38%),
          linear-gradient(135deg, rgba(15, 23, 42, 0.92), rgba(2, 6, 23, 0.82));
        padding: 1.6rem;
        box-shadow:
          0 24px 70px rgba(0, 0, 0, 0.44),
          inset 0 0 0 1px rgba(255, 255, 255, 0.045);
        backdrop-filter: blur(14px);
      }

      .company-card::after {
        content: "";
        position: absolute;
        inset: 0;
        background:
          linear-gradient(115deg, rgba(255, 255, 255, 0.08), transparent 28%, transparent 70%, rgba(103, 232, 249, 0.08)),
          repeating-linear-gradient(
            0deg,
            rgba(255, 255, 255, 0.035) 0px,
            rgba(255, 255, 255, 0.035) 1px,
            transparent 1px,
            transparent 9px
          );
        opacity: 0.22;
        mix-blend-mode: overlay;
        pointer-events: none;
      }

      .company-card-header {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        gap: 1rem;
      }

      .company-icon {
        display: inline-flex;
        height: 3.2rem;
        width: 3.2rem;
        flex: none;
        align-items: center;
        justify-content: center;
        border-radius: 1rem;
        border: 1px solid rgba(125, 211, 252, 0.34);
        background: rgba(8, 47, 73, 0.72);
        color: #cffafe;
        box-shadow:
          0 12px 32px rgba(14, 165, 233, 0.16),
          inset 0 0 0 1px rgba(255, 255, 255, 0.055);
      }

      .company-kicker {
        display: block;
        font-size: 0.75rem;
        font-weight: 800;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: rgba(103, 232, 249, 0.82);
      }

      .company-card h2 {
        margin-top: 0.1rem;
        font-size: 1.35rem;
        font-weight: 900;
        color: rgba(248, 250, 252, 0.98);
      }

      .company-card p {
        position: relative;
        z-index: 1;
        margin-top: 1.25rem;
        font-size: 0.98rem;

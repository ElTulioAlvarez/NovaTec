---
import Navbar from "../componentes/navbar.astro";
import Footer from "../componentes/footer.astro";
import SEO from "../componentes/seo.astro";
import CircuitBG from "../componentes/CircuitBG.astro";
import "../styles/global.css";

const title = "Cotizar — NeoTec Business Solutions";
const description =
  "Solicita una cotización profesional para desarrollo web, software a medida, e-commerce, POS, automatización o social media.";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <SEO
      title={title}
      description={description}
      type="website"
      locale="es_MX"
    />

    <title>{title}</title>
  </head>

  <body
    class="min-h-screen bg-slate-950 text-slate-100 selection:bg-cyan-500/30 selection:text-white"
  >
    <Navbar logoSrc="/novatec-logo.webp" />
    <CircuitBG />

    <main class="relative z-10 overflow-x-clip">
      <!-- HERO -->
      <header class="relative pt-28 pb-10 sm:pt-32 sm:pb-12 lg:pt-40 lg:pb-14">
        <section class="mx-auto w-full max-w-[76rem] px-5 sm:px-6 lg:px-8">
          <div class="max-w-4xl space-y-5">
            <span
              class="inline-flex w-fit items-center rounded-full border border-cyan-300/25 bg-cyan-300/10 px-3 py-1 text-[11px] sm:text-xs tracking-wide text-cyan-200"
            >
              Cotización profesional
            </span>

            <h1
              class="font-extrabold leading-tight tracking-tight text-[clamp(2rem,2.6vw+1rem,3.45rem)]"
            >
              Construyamos una solución para tu negocio
            </h1>

            <p class="measure text-[15.8px] sm:text-[16.4px] text-slate-200/90">
              En NeoTec Business Solutions desarrollamos páginas web, sistemas a
              medida, e-commerce, POS, automatización de procesos y estrategias
              digitales para negocios que quieren operar mejor, vender más y
              crecer con tecnología.
            </p>

            <div class="flex flex-wrap gap-3 pt-2">
              <span class="mini-pill">Desarrollo web</span>
              <span class="mini-pill">Software a medida</span>
              <span class="mini-pill">POS / ERP</span>
              <span class="mini-pill">E-commerce</span>
              <span class="mini-pill">Social media</span>
            </div>
          </div>
        </section>
      </header>

      <!-- FORMULARIO + CONTACTO -->
      <section class="section-space pt-0">
        <div class="mx-auto max-w-[76rem] px-5 sm:px-6 lg:px-8">
          <div
            class="grid gap-8 sm:gap-10 lg:grid-cols-[1.18fr,0.82fr] lg:gap-12"
          >
            <!-- FORMULARIO -->
            <article class="holo-card">
              <div class="holo-inner p-6 sm:p-8 lg:p-10">
                <div class="mb-7">
                  <span
                    class="inline-flex w-fit items-center rounded-full border border-white/10 bg-white/[0.06] px-3 py-1 text-[11px] tracking-wide text-slate-300"
                  >
                    Brief inicial
                  </span>

                  <h2 class="mt-4 text-2xl font-bold">
                    Solicita tu cotización
                  </h2>

                  <p class="mt-3 text-sm leading-6 text-slate-300/90">
                    Compártenos la información principal de tu proyecto. Entre
                    más claro sea el brief, más precisa será la propuesta.
                  </p>
                </div>

                <form
                  id="cotizarForm"
                  class="grid gap-5"
                  enctype="multipart/form-data"
                  novalidate
                >
                  <!-- Honeypot anti-bots -->
                  <div class="hidden" aria-hidden="true">
                    <label>
                      Empresa alternativa
                      <input
                        type="text"
                        name="company"
                        tabindex="-1"
                        autocomplete="off"
                        class="ui-input"
                      />
                    </label>
                  </div>

                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                    <label class="block">
                      <span class="form-label">Nombre completo*</span>
                      <input
                        required
                        name="nombre"
                        type="text"
                        autocomplete="name"
                        placeholder="Ej. Ana Pérez"
                        class="ui-input"
                      />
                    </label>

                    <label class="block">
                      <span class="form-label">Empresa / negocio</span>
                      <input
                        name="empresa"
                        type="text"
                        autocomplete="organization"
                        placeholder="Opcional"
                        class="ui-input"
                      />
                    </label>
                  </div>

                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                    <label class="block">
                      <span class="form-label">Email*</span>
                      <input
                        required
                        name="email"
                        type="email"
                        autocomplete="email"
                        inputmode="email"
                        placeholder="tu@empresa.com"
                        class="ui-input"
                      />
                    </label>

                    <label class="block">
                      <span class="form-label">WhatsApp / teléfono*</span>
                      <input
                        required
                        name="telefono"
                        type="tel"
                        autocomplete="tel"
                        inputmode="tel"
                        placeholder="Ej. +52 443 123 4567"
                        class="ui-input"
                      />
                    </label>
                  </div>

                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                    <label class="block">
                      <span class="form-label">Tipo de proyecto*</span>
                      <select required name="tipo" class="ui-input">
                        <option value="">Selecciona una opción</option>
                        <option>Sitio web corporativo</option>
                        <option>Landing page</option>
                        <option>E-commerce</option>
                        <option>Software a medida</option>
                        <option>Sistema POS / Punto de venta</option>
                        <option>Sistema ERP / administrativo</option>
                        <option>Automatización de procesos</option>
                        <option>Aplicación web</option>
                        <option>Aplicación móvil</option>
                        <option>Gestión de redes sociales</option>
                        <option>Branding / identidad visual</option>
                        <option>Soporte o mantenimiento</option>
                        <option>Otro</option>
                      </select>
                    </label>

                    <label class="block">
                      <span class="form-label">Etapa del proyecto*</span>
                      <select required name="etapa" class="ui-input">
                        <option value="">Selecciona una opción</option>
                        <option>Solo tengo la idea</option>
                        <option>Ya tengo requerimientos definidos</option>
                        <option>Ya tengo diseño o referencias</option>
                        <option>Ya existe un sistema y quiero mejorarlo</option>
                        <option>Necesito soporte o mantenimiento</option>
                        <option>Quiero migrar o modernizar una solución existente</option>
                      </select>
                    </label>
                  </div>

                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                    <label class="block">
                      <span class="form-label">Horizonte de entrega</span>
                      <select name="tiempo" class="ui-input">
                        <option value="">Flexible</option>
                        <option>Lo antes posible</option>
                        <option>2–4 semanas</option>
                        <option>1–2 meses</option>
                        <option>3–4 meses</option>
                        <option>+4 meses</option>
                      </select>
                    </label>

                    <label class="block">
                      <span class="form-label">Prioridad</span>
                      <select name="prioridad" class="ui-input">
                        <option value="">Selecciona una opción</option>
                        <option>Exploratoria: quiero evaluar opciones</option>
                        <option>Media: necesito iniciar pronto</option>
                        <option>Alta: tengo una fecha límite</option>
                        <option>Crítica: el proyecto ya urge</option>
                      </select>
                    </label>
                  </div>

                  <fieldset>
                    <legend class="form-label mb-2">
                      Rango de presupuesto estimado, MXN
                    </legend>

                    <div class="flex flex-wrap gap-2.5">
                      {
                        [
                          "< 10,000",
                          "10,000 – 30,000",
                          "30,000 – 60,000",
                          "60,000 – 120,000",
                          "> 120,000",
                          "Aún no lo tengo definido",
                        ].map((p) => (
                          <label class="chip cursor-pointer">
                            <input
                              type="radio"
                              name="presupuesto"
                              value={p}
                              class="sr-only peer"
                            />
                            <span>{p}</span>
                          </label>
                        ))
                      }
                    </div>
                  </fieldset>

                  <label class="block">
                    <span class="form-label">Descripción del proyecto*</span>
                    <textarea
                      required
                      name="descripcion"
                      rows="7"
                      placeholder="Cuéntanos qué necesitas, objetivos, funcionalidades, referencias, procesos que quieres mejorar, módulos deseados o cualquier detalle importante."
                      class="ui-input resize-y"></textarea>
                  </label>

                  <label class="block">
                    <span class="form-label">Referencias o enlaces útiles</span>
                    <textarea
                      name="referencias"
                      rows="3"
                      placeholder="Puedes agregar sitios de referencia, enlaces a redes sociales, documentos, sistemas actuales o ejemplos de lo que buscas."
                      class="ui-input resize-y"></textarea>
                  </label>

                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                    <label class="block">
                      <span class="form-label">Adjuntar archivo opcional</span>
                      <input
                        name="archivo"
                        type="file"
                        class="ui-input file:mr-3 file:rounded-md file:border-0 file:bg-white/10 file:px-3 file:py-2 file:text-sm file:text-slate-100 hover:file:bg-white/20"
                      />
                      <span class="mt-2 block text-xs text-slate-400">
                        Puedes adjuntar brief, logo, captura, PDF o referencia.
                      </span>
                    </label>

                    <label class="flex items-start gap-3 mt-2 sm:mt-8">
                      <input
                        type="checkbox"
                        name="privacidad"
                        required
                        class="mt-1 h-4 w-4 rounded border-white/20 bg-white/10"
                      />
                      <span class="text-sm leading-6 text-slate-300/90">
                        Acepto el uso de mis datos para que NeoTec Business
                        Solutions me contacte sobre esta solicitud.
                      </span>
                    </label>
                  </div>

                  <div class="pt-2">
                    <button
                      id="submitBtn"
                      class="btn-primary w-full sm:w-auto"
                      type="submit"
                    >
                      Enviar solicitud
                    </button>

                    <p
                      id="formMsg"
                      class="mt-3 text-sm text-slate-300/90"
                      aria-live="polite"
                    >
                    </p>
                  </div>
                </form>
              </div>
            </article>

            <!-- COLUMNA DERECHA -->
            <aside class="grid gap-8 content-start">
              <!-- CONTACTO -->
              <article class="holo-card">
                <div class="holo-inner p-6 sm:p-8 lg:p-10">
                  <span
                    class="inline-flex w-fit items-center rounded-full border border-cyan-300/25 bg-cyan-300/10 px-3 py-1 text-[11px] tracking-wide text-cyan-200"
                  >
                    Contacto directo
                  </span>

                  <h3 class="mt-4 text-xl font-semibold">
                    Hablemos de tu proyecto
                  </h3>

                  <p class="mt-3 text-sm leading-6 text-slate-300/90">
                    Te ayudamos a aterrizar la idea en una solución clara,
                    viable y escalable. Sin humo, sin promesas mágicas y sin
                    venderte una nave espacial cuando solo necesitas un buen
                    sistema.
                  </p>

                  <ul class="mt-6 space-y-4 text-slate-300/95">
                    <li>
                      <span class="block text-sm font-medium text-slate-100">
                        Dirección comercial
                      </span>
                      <a
                        class="underline decoration-cyan-400/40 underline-offset-4 hover:decoration-cyan-300"
                        href="mailto:noe.hdz@neotecmx.com"
                      >
                        noe.hdz@neotecmx.com
                      </a>
                    </li>

                    <li>
                      <span class="block text-sm font-medium text-slate-100">
                        Cotizaciones y desarrollo
                      </span>
                      <a
                        class="underline decoration-cyan-400/40 underline-offset-4 hover:decoration-cyan-300"
                        href="mailto:malvarez@neotecmx.com"
                      >
                        malvarez@neotecmx.com
                      </a>
                    </li>

                    <li>
                      <span class="block text-sm font-medium text-slate-100">
                        WhatsApp
                      </span>
                      <a
                        class="underline decoration-cyan-400/40 underline-offset-4 hover:decoration-cyan-300"
                        href="https://wa.me/524433711589"
                        target="_blank"
                        rel="noopener"
                      >
                        +52 443 371 1589
                      </a>
                    </li>

                    <li>
                      <span class="block text-sm font-medium text-slate-100">
                        Ubicación
                      </span>
                      <span class="text-slate-300/90">
                        Morelia, Michoacán — México
                      </span>
                    </li>
                  </ul>
                </div>
              </article>

              <!-- PROCESO -->
              <article class="holo-card">
                <div class="holo-inner p-6 sm:p-8">
                  <h3 class="text-lg font-semibold">
                    ¿Qué pasa después?
                  </h3>

                  <ol class="mt-5 space-y-4">
                    <li class="process-item">
                      <span class="process-number">1</span>
                      <div>
                        <h4 class="process-title">Revisamos tu solicitud</h4>
                        <p class="process-text">
                          Analizamos el alcance inicial, objetivos y tipo de
                          solución que necesitas.
                        </p>
                      </div>
                    </li>

                    <li class="process-item">
                      <span class="process-number">2</span>
                      <div>
                        <h4 class="process-title">Aclaramos dudas clave</h4>
                        <p class="process-text">
                          Te contactamos para afinar requerimientos, tiempos y
                          prioridades.
                        </p>
                      </div>
                    </li>

                    <li class="process-item">
                      <span class="process-number">3</span>
                      <div>
                        <h4 class="process-title">Preparamos propuesta</h4>
                        <p class="process-text">
                          Recibes una propuesta con alcance, entregables, costo
                          estimado y ruta de trabajo.
                        </p>
                      </div>
                    </li>
                  </ol>
                </div>
              </article>

              <!-- MAPA -->
              <article class="holo-card">
                <div class="holo-inner overflow-hidden p-0">
                  <div class="aspect-[4/3] sm:aspect-[16/10]">
                    <iframe
                      title="Ubicación — Morelia, Michoacán"
                      loading="lazy"
                      class="w-full h-full rounded-[1.05rem]"
                      src="https://www.openstreetmap.org/export/embed.html?bbox=-101.235%2C19.675%2C-101.160%2C19.735&layer=mapnik&marker=19.705%2C-101.194"
                    >
                    </iframe>
                  </div>
                </div>
              </article>
            </aside>
          </div>
        </div>
      </section>

      <!-- CTA FINAL -->
      <section class="section-space">
        <div class="mx-auto max-w-[76rem] px-5 sm:px-6 lg:px-8">
          <div
            class="rounded-2xl border border-cyan-500/20 bg-gradient-to-r from-cyan-500/10 via-white/5 to-fuchsia-500/10 p-8 sm:p-10 lg:p-12 flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between backdrop-blur"
          >
            <div class="space-y-2">
              <h2 class="font-bold text-[clamp(1.15rem,0.8vw+1rem,1.65rem)]">
                ¿Listo para convertir tu idea en una solución real?
              </h2>

              <p class="measure-sm text-slate-100/90">
                Cuéntanos qué necesitas construir, vender, automatizar o
                mejorar. Nosotros nos encargamos de aterrizarlo técnicamente.
              </p>
            </div>

            <a
              href="#cotizarForm"
              class="btn-primary w-full sm:w-auto"
            >
              Ir al formulario
            </a>
          </div>
        </div>
      </section>
    </main>

    <Footer />

    <script is:inline>
      (function () {
        const form = document.getElementById("cotizarForm");
        const btn = document.getElementById("submitBtn");
        const msg = document.getElementById("formMsg");

        if (!form || !btn || !msg) return;

        const endpoint = new URL("/api/cotizar", location.origin);

        function getPayload(fd) {
          const entries = [...fd.entries()].filter(([key, value]) => {
            if (key === "archivo") return false;
            if (value instanceof File) return false;
            return true;
          });

          return Object.fromEntries(entries);
        }

        async function postJSON(url, payload) {
          const res = await fetch(url, {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify(payload),
            credentials: "same-origin",
          });

          let data = {};

          try {
            data = await res.json();
          } catch {
            data = {};
          }

          if (!res.ok || !data.ok) {
            const reason = data.error || `${res.status} ${res.statusText}`;
            throw new Error(reason);
          }

          return data;
        }

        form.addEventListener("submit", async (event) => {
          event.preventDefault();

          if (!form.reportValidity()) return;

          const fd = new FormData(form);

          /**
           * Honeypot:
           * Si viene lleno, probablemente es bot.
           * Respondemos como éxito para no darle pistas.
           */
          const honeypot = String(fd.get("company") || "").trim();

          if (honeypot.length > 0) {
            msg.textContent =
              "¡Gracias! Recibimos tu solicitud. Te contactaremos pronto.";
            form.reset();
            return;
          }

          msg.textContent = "";
          btn.disabled = true;

          const oldLabel = btn.textContent;
          btn.textContent = "Enviando…";

          const payload = getPayload(fd);

          try {
            await postJSON(endpoint, payload);

            msg.textContent =
              "¡Gracias! Recibimos tu solicitud. Te contactaremos pronto.";
            msg.classList.remove("text-red-300");
            msg.classList.add("text-cyan-200");

            form.reset();
          } catch (err) {
            console.error("cotizar fetch error:", err);

            msg.textContent =
              "No se pudo enviar la solicitud: " +
              (err?.message || "Error inesperado");

            msg.classList.remove("text-cyan-200");
            msg.classList.add("text-red-300");
          } finally {
            btn.disabled = false;
            btn.textContent = oldLabel;
          }
        });
      })();
    </script>
  </body>
</html>

<style>
  /* ====== Medida y ritmo ====== */
  .measure {
    max-width: 70ch;
    line-height: 1.75;
    font-size: 1rem;
  }

  .measure-sm {
    max-width: 72ch;
    line-height: 1.65;
  }

  .section-space {
    padding-top: 3.25rem;
    padding-bottom: 3.25rem;
  }

  @media (min-width: 640px) {
    .section-space {
      padding-top: 4.25rem;
      padding-bottom: 4.25rem;
    }
  }

  @media (min-width: 1024px) {
    .section-space {
      padding-top: 5.25rem;
      padding-bottom: 5.25rem;
    }
  }

  /* ====== Labels ====== */
  .form-label {
    display: block;
    margin-bottom: 0.35rem;
    font-size: 0.875rem;
    color: rgba(226, 232, 240, 0.92);
  }

  /* ====== Mini pills ====== */
  .mini-pill {
    display: inline-flex;
    align-items: center;
    border-radius: 9999px;
    border: 1px solid rgba(103, 232, 249, 0.18);
    background: rgba(103, 232, 249, 0.07);
    padding: 0.45rem 0.8rem;
    font-size: 0.78rem;
    color: rgba(207, 250, 254, 0.92);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.035);
  }

  /* ====== Input base ====== */
  .ui-input {
    width: 100%;
    border-radius: 0.8rem;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: rgba(255, 255, 255, 0.06);
    padding: 0.8rem 0.95rem;
    color: #eaf2ff;
    outline: none;
    transition:
      border-color 0.2s ease,
      background 0.2s ease,
      box-shadow 0.2s ease;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.05);
  }

  .ui-input::placeholder {
    color: rgba(226, 232, 240, 0.55);
  }

  .ui-input:focus {
    border-color: rgba(103, 232, 249, 0.65);
    background: rgba(255, 255, 255, 0.08);
    box-shadow: 0 0 0 3px rgba(103, 232, 249, 0.15);
  }

  .ui-input:disabled {
    cursor: not-allowed;
    opacity: 0.65;
  }

  select.ui-input {
    cursor: pointer;
  }

  select.ui-input option {
    background: #0f172a;
    color: #eaf2ff;
  }

  /* ====== Chips ====== */
  .chip {
    display: inline-flex;
    align-items: center;
    font-size: 0.85rem;
    border-radius: 9999px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: rgba(255, 255, 255, 0.07);
    padding: 0.5rem 0.95rem;
    color: rgba(236, 244, 255, 0.92);
    transition:
      border-color 0.2s ease,
      background 0.2s ease,
      color 0.2s ease,
      box-shadow 0.2s ease,
      transform 0.08s ease;
  }

  .chip:hover {
    border-color: rgba(103, 232, 249, 0.35);
    background: rgba(103, 232, 249, 0.09);
  }

  .chip:active {
    transform: translateY(1px);
  }

  .chip:has(input:checked) {
    border-color: rgba(103, 232, 249, 0.75);
    background: rgba(103, 232, 249, 0.16);
    color: #cffafe;
    box-shadow: 0 0 0 3px rgba(103, 232, 249, 0.1);
    font-weight: 700;
  }

  /* ====== Botón ====== */
  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    border-radius: 0.95rem;
    background: rgba(6, 182, 212, 0.95);
    padding: 0.95rem 1.7rem;
    font-weight: 800;
    color: #0f172a;
    transition:
      background 0.2s ease,
      transform 0.08s ease,
      box-shadow 0.2s ease,
      opacity 0.2s ease;
    box-shadow: 0 8px 24px rgba(34, 211, 238, 0.18);
  }

  .btn-primary:hover {
    background: rgba(103, 232, 249, 1);
    box-shadow: 0 10px 28px rgba(103, 232, 249, 0.22);
  }

  .btn-primary:active {
    transform: translateY(1px);
  }

  .btn-primary:disabled {
    cursor: wait;
    opacity: 0.7;
  }

  /* ====== Proceso ====== */
  .process-item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.9rem;
  }

  .process-number {
    display: inline-flex;
    width: 2rem;
    height: 2rem;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    border: 1px solid rgba(103, 232, 249, 0.3);
    background: rgba(103, 232, 249, 0.1);
    color: #cffafe;
    font-size: 0.8rem;
    font-weight: 800;
  }

  .process-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: rgba(248, 250, 252, 0.96);
  }

  .process-text {
    margin-top: 0.25rem;
    font-size: 0.86rem;
    line-height: 1.6;
    color: rgba(203, 213, 225, 0.88);
  }

  /* ====== Holo card ====== */
  @property --angle {
    syntax: "<angle>";
    initial-value: 0deg;
    inherits: false;
  }


---
import Navbar from "../componentes/navbar.astro";
import Footer from "../componentes/footer.astro";
import SEO from "../componentes/seo.astro";
import CircuitBG from "../componentes/CircuitBG.astro";
import "../styles/global.css";

const title = "Cotizar — NeoTec Business Solutions";
const description =
  "Solicita una cotización profesional para desarrollo web, software a medida, e-commerce, POS, automatización, social media o soluciones digitales para tu negocio.";

const projectTypes = [
  {
    title: "Web / Landing",
    text: "Sitios profesionales para presentar tu negocio, captar clientes y generar confianza.",
    tag: "Presencia digital",
  },
  {
    title: "Software / POS",
    text: "Sistemas para ventas, caja, inventario, administración, reportes y operación diaria.",
    tag: "Operación",
  },
  {
    title: "Social Media",
    text: "Gestión de redes, contenido, campañas y presencia digital para marcas y negocios.",
    tag: "Marketing",
  },
  {
    title: "Automatización",
    text: "Flujos, reportes, integraciones y herramientas para reducir trabajo manual.",
    tag: "Procesos",
  },
];

const proposalItems = [
  "Diagnóstico inicial",
  "Alcance funcional",
  "Tiempo estimado",
  "Costo por etapas",
  "Recomendaciones técnicas",
  "Opciones de soporte",
];

const examples = [
  "Sistema POS para tienda, restaurante o servicios",
  "Página web corporativa",
  "Landing page para campaña",
  "E-commerce",
  "Sistema administrativo interno",
  "CRM básico",
  "Control de inventario",
  "Automatización de reportes",
  "Gestión de redes sociales",
  "MicroWeb para negocio",
];

const whatsappHref =
  "https://wa.me/524433711589?text=Hola%20NeoTec%2C%20quiero%20cotizar%20un%20proyecto%20por%20favor.";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <SEO
      title={title}
      description={description}
      type="website"
      locale="es_MX"
    />

    <title>{title}</title>
  </head>

  <body
    class="min-h-screen bg-slate-950 text-slate-100 selection:bg-cyan-500/30 selection:text-white"
  >
    <Navbar logoSrc="/novatec-logo.webp" />
    <CircuitBG opacity={0.24} />

    <main class="relative z-10 overflow-x-clip">
      <!-- HERO -->
      <header class="relative pt-28 pb-10 sm:pt-32 sm:pb-12 lg:pt-40 lg:pb-16">
        <section class="mx-auto w-full max-w-[76rem] px-5 sm:px-6 lg:px-8">
          <div class="quote-hero">
            <div class="quote-hero-copy">
              <span class="section-pill">
                Cotización profesional
              </span>

              <h1 class="quote-title">
                Cuéntanos tu idea, problema o proceso. Lo aterrizamos en una solución.
              </h1>

              <p class="quote-lead">
                En NeoTec Business Solutions desarrollamos páginas web, sistemas
                a medida, POS, e-commerce, automatización y estrategias digitales
                para negocios que quieren operar mejor, vender más y crecer con
                tecnología.
              </p>

              <div class="hero-actions">
                <a href="#cotizarForm" class="btn-primary">
                  Iniciar solicitud
                  <span aria-hidden="true">→</span>
                </a>

                <a href={whatsappHref} target="_blank" rel="noopener" class="btn-ghost">
                  Hablar por WhatsApp
                </a>
              </div>
            </div>

            <aside class="quote-hero-panel">
              <div class="quote-terminal">
                <div class="terminal-top">
                  <span></span>
                  <span></span>
                  <span></span>
                </div>

                <div class="terminal-body">
                  <p><span>$</span> analizar_necesidad</p>
                  <p><span>✓</span> operación · ventas · procesos · marca</p>
                  <p><span>$</span> generar_propuesta --clara --viable</p>
                </div>
              </div>

              <div class="quote-mini-stats">
                <div>
                  <strong>360°</strong>
                  <span>Visión integral</span>
                </div>
                <div>
                  <strong>B2B</strong>
                  <span>Enfoque negocio</span>
                </div>
                <div>
                  <strong>MX</strong>
                  <span>Atención remota</span>
                </div>
              </div>
            </aside>
          </div>
        </section>
      </header>

      <!-- QUÉ PUEDES COTIZAR -->
      <section class="section-space pt-0">
        <div class="mx-auto max-w-[76rem] px-5 sm:px-6 lg:px-8">
          <div class="section-heading">
            <span class="section-pill">
              Qué puedes cotizar
            </span>

            <h2>Soluciones digitales para diferentes necesidades</h2>

            <p>
              No necesitas tener todo definido. Puedes partir de una idea, una
              necesidad operativa o un problema concreto que quieras resolver.
            </p>
          </div>

          <div class="project-grid">
            {
              projectTypes.map((item) => (
                <article class="project-card">
                  <span>{item.tag}</span>
                  <h3>{item.title}</h3>
                  <p>{item.text}</p>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <!-- FORMULARIO + PANEL COMERCIAL -->
      <section class="section-space pt-0">
        <div class="mx-auto max-w-[76rem] px-5 sm:px-6 lg:px-8">
          <div class="quote-layout">
            <!-- FORMULARIO -->
            <article class="quote-form-card">
              <div class="form-head">
                <span class="section-pill">
                  Brief inicial
                </span>

                <h2>Solicita tu cotización</h2>

                <p>
                  Compártenos la información principal de tu proyecto. Entre más
                  claro sea el brief, más precisa será la propuesta.
                </p>
              </div>

              <form
                id="cotizarForm"
                class="quote-form"
                enctype="multipart/form-data"
                novalidate
              >
                <!-- Honeypot anti-bots -->
                <div class="hidden" aria-hidden="true">
                  <label>
                    Empresa alternativa
                    <input
                      type="text"
                      name="company"
                      tabindex="-1"
                      autocomplete="off"
                      class="ui-input"
                    />
                  </label>
                </div>

                <!-- DATOS DE CONTACTO -->
                <section class="form-section">
                  <div class="form-section-title">
                    <span>01</span>
                    <h3>Datos de contacto</h3>
                  </div>

                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                    <label class="block">
                      <span class="form-label">Nombre completo*</span>
                      <input
                        required
                        name="nombre"
                        type="text"
                        autocomplete="name"
                        placeholder="Ej. Ana Pérez"
                        class="ui-input"
                      />
                    </label>

                    <label class="block">
                      <span class="form-label">Empresa / negocio</span>
                      <input
                        name="empresa"
                        type="text"
                        autocomplete="organization"
                        placeholder="Opcional"
                        class="ui-input"
                      />
                    </label>
                  </div>

                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                    <label class="block">
                      <span class="form-label">Email*</span>
                      <input
                        required
                        name="email"
                        type="email"
                        autocomplete="email"
                        inputmode="email"
                        placeholder="tu@empresa.com"
                        class="ui-input"
                      />
                    </label>

                    <label class="block">
                      <span class="form-label">WhatsApp / teléfono*</span>
                      <input
                        required
                        name="telefono"
                        type="tel"
                        autocomplete="tel"
                        inputmode="tel"
                        placeholder="Ej. +52 443 123 4567"
                        class="ui-input"
                      />
                    </label>
                  </div>
                </section>

                <!-- PROYECTO -->
                <section class="form-section">
                  <div class="form-section-title">
                    <span>02</span>
                    <h3>Proyecto</h3>
                  </div>

                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                    <label class="block">
                      <span class="form-label">Tipo de proyecto*</span>
                      <select required name="tipo" class="ui-input">
                        <option value="">Selecciona una opción</option>
                        <option>Sitio web corporativo</option>
                        <option>Landing page</option>
                        <option>MicroWeb para negocio</option>
                        <option>E-commerce</option>
                        <option>Software a medida</option>
                        <option>Sistema POS / Punto de venta</option>
                        <option>Sistema ERP / administrativo</option>
                        <option>Automatización de procesos</option>
                        <option>Aplicación web</option>
                        <option>Aplicación móvil</option>
                        <option>Gestión de redes sociales</option>
                        <option>Branding / identidad visual</option>
                        <option>Soporte o mantenimiento</option>
                        <option>Otro</option>
                      </select>
                    </label>

                    <label class="block">
                      <span class="form-label">Etapa del proyecto*</span>
                      <select required name="etapa" class="ui-input">
                        <option value="">Selecciona una opción</option>
                        <option>Solo tengo la idea</option>
                        <option>Ya tengo requerimientos definidos</option>
                        <option>Ya tengo diseño o referencias</option>
                        <option>Ya existe un sistema y quiero mejorarlo</option>
                        <option>Necesito soporte o mantenimiento</option>
                        <option>Quiero migrar o modernizar una solución existente</option>
                      </select>
                    </label>
                  </div>

                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                    <label class="block">
                      <span class="form-label">Horizonte de entrega</span>
                      <select name="tiempo" class="ui-input">
                        <option value="">Flexible</option>
                        <option>Lo antes posible</option>
                        <option>2–4 semanas</option>
                        <option>1–2 meses</option>
                        <option>3–4 meses</option>
                        <option>+4 meses</option>
                      </select>
                    </label>

                    <label class="block">
                      <span class="form-label">Prioridad</span>
                      <select name="prioridad" class="ui-input">
                        <option value="">Selecciona una opción</option>
                        <option>Exploratoria: quiero evaluar opciones</option>
                        <option>Media: necesito iniciar pronto</option>
                        <option>Alta: tengo una fecha límite</option>
                        <option>Crítica: el proyecto ya urge</option>
                      </select>
                    </label>
                  </div>
                </section>

                <!-- INVERSIÓN Y CONTEXTO -->
                <section class="form-section">
                  <div class="form-section-title">
                    <span>03</span>
                    <h3>Inversión y contexto</h3>
                  </div>

                  <fieldset>
                    <legend class="form-label mb-2">
                      Inversión estimada para el proyecto
                    </legend>

                    <p class="field-hint">
                      Esto nos ayuda a recomendar una solución viable según el alcance.
                    </p>

                    <div class="mt-3 flex flex-wrap gap-2.5">
                      {
                        [
                          "< 10,000",
                          "10,000 – 30,000",
                          "30,000 – 60,000",
                          "60,000 – 120,000",
                          "> 120,000",
                          "Aún no lo tengo definido",
                        ].map((p) => (
                          <label class="chip cursor-pointer">
                            <input
                              type="radio"
                              name="presupuesto"
                              value={p}
                              class="sr-only peer"
                            />
                            <span>{p}</span>
                          </label>
                        ))
                      }
                    </div>
                  </fieldset>

                  <label class="block">
                    <span class="form-label">Descripción del proyecto*</span>
                    <textarea
                      required
                      name="descripcion"
                      rows="7"
                      placeholder="Cuéntanos qué necesitas, qué problema quieres resolver, objetivos, funcionalidades, procesos que quieres mejorar o cualquier detalle importante."
                      class="ui-input resize-y"></textarea>
                  </label>

                  <label class="block">
                    <span class="form-label">Referencias o enlaces útiles</span>
                    <textarea
                      name="referencias"
                      rows="3"
                      placeholder="Puedes agregar sitios de referencia, redes sociales, documentos, sistemas actuales o ejemplos de lo que buscas."
                      class="ui-input resize-y"></textarea>
                  </label>

                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                    <label class="block">
                      <span class="form-label">Adjuntar archivo opcional</span>
                      <input
                        name="archivo"
                        type="file"
                        class="ui-input file:mr-3 file:rounded-md file:border-0 file:bg-white/10 file:px-3 file:py-2 file:text-sm file:text-slate-100 hover:file:bg-white/20"
                      />
                      <span class="mt-2 block text-xs text-slate-400">
                        Puedes adjuntar brief, logo, captura, PDF o referencia.
                      </span>
                    </label>

                    <label class="flex items-start gap-3 mt-2 sm:mt-8">
                      <input
                        type="checkbox"
                        name="privacidad"
                        required
                        class="mt-1 h-4 w-4 rounded border-white/20 bg-white/10"
                      />
                      <span class="text-sm leading-6 text-slate-300/90">
                        Acepto el uso de mis datos para que NeoTec Business
                        Solutions me contacte sobre esta solicitud.
                      </span>
                    </label>
                  </div>
                </section>

                <div class="form-submit">
                  <button
                    id="submitBtn"
                    class="btn-primary w-full sm:w-auto"
                    type="submit"
                  >
                    Enviar solicitud
                  </button>

                  <a
                    href={whatsappHref}
                    target="_blank"
                    rel="noopener"
                    class="btn-ghost w-full sm:w-auto"
                  >
                    Prefiero WhatsApp
                  </a>

                  <p
                    id="formMsg"
                    class="mt-3 text-sm text-slate-300/90 sm:col-span-2"
                    aria-live="polite"
                  >
                  </p>
                </div>
              </form>
            </article>

            <!-- PANEL DERECHO -->
            <aside class="quote-side">
              <!-- PROPUESTA -->
              <article class="side-card featured">
                <span class="section-pill">
                  Qué recibirás
                </span>

                <h3>Una propuesta clara, no humo digital</h3>

                <p>
                  Revisamos tu solicitud y preparamos una ruta viable según el
                  alcance, etapa y presupuesto estimado.
                </p>

                <ul class="proposal-list">
                  {
                    proposalItems.map((item) => (
                      <li>
                        <span aria-hidden="true">✓</span>
                        {item}
                      </li>
                    ))
                  }
                </ul>
              </article>

              <!-- PROCESO -->
              <article class="side-card">
                <h3>¿Qué pasa después?</h3>

                <ol class="process-list">
                  <li>
                    <span>1</span>
                    <div>
                      <h4>Revisamos tu solicitud</h4>
                      <p>Analizamos necesidad, contexto, alcance inicial y tipo de solución.</p>
                    </div>
                  </li>

                  <li>
                    <span>2</span>
                    <div>
                      <h4>Aclaramos dudas clave</h4>
                      <p>Te contactamos para afinar requerimientos, prioridad y tiempos.</p>
                    </div>
                  </li>

                  <li>
                    <span>3</span>
                    <div>
                      <h4>Preparamos propuesta</h4>
                      <p>Recibes alcance, entregables, estimación y ruta de trabajo.</p>
                    </div>
                  </li>
                </ol>
              </article>

              <!-- CONTACTO -->
              <article class="side-card">
                <h3>Contacto directo</h3>

                <ul class="contact-list">
                  <li>
                    <span>Dirección comercial</span>
                    <a href="mailto:noe.hdz@neotecmx.com">
                      noe.hdz@neotecmx.com
                    </a>
                  </li>

                  <li>
                    <span>Cotizaciones y desarrollo</span>
                    <a href="mailto:malvarez@neotecmx.com">
                      malvarez@neotecmx.com
                    </a>
                  </li>

                  <li>
                    <span>WhatsApp</span>
                    <a href={whatsappHref} target="_blank" rel="noopener">
                      +52 443 371 1589
                    </a>
                  </li>

                  <li>
                    <span>Ubicación</span>
                    <p>Morelia, Michoacán · Atención remota en México</p>
                  </li>
                </ul>
              </article>

              <!-- AYUDA -->
              <article class="side-card help-card">
                <h3>¿Aún no sabes por dónde empezar?</h3>

                <p>
                  No hay problema. Describe el problema que quieres resolver y
                  nosotros te ayudamos a aterrizarlo. La bola de cristal sigue
                  en beta, pero el diagnóstico sí jala.
                </p>

                <a href={whatsappHref} target="_blank" rel="noopener" class="side-link">
                  Orientarme por WhatsApp →
                </a>
              </article>
            </aside>
          </div>
        </div>
      </section>

      <!-- EJEMPLOS -->
      <section class="section-space pt-0">
        <div class="mx-auto max-w-[76rem] px-5 sm:px-6 lg:px-8">
          <div class="examples-card">
            <div>
              <span class="section-pill">
                Ejemplos
              </span>

              <h2>Proyectos que podemos cotizar</h2>

              <p>
                Si tu necesidad se parece a alguno de estos casos, vas por buen
                camino. Si no aparece, también puedes escribirnos: muchas soluciones
                nacen de procesos muy específicos.
              </p>
            </div>

            <div class="examples-grid">
              {
                examples.map((item) => (
                  <div class="example-item">
                    <span aria-hidden="true">✓</span>
                    <p>{item}</p>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </section>

      <!-- CTA FINAL -->
      <section class="section-space">
        <div class="mx-auto max-w-[76rem] px-5 sm:px-6 lg:px-8">
          <div class="final-cta">
            <div>
              <span class="section-pill">
                Siguiente paso
              </span>

              <h2>¿Tienes una idea, problema o proceso que quieres mejorar?</h2>

              <p>
                Cuéntanos qué necesitas. Te ayudamos a convertirlo en una
                propuesta clara, viable y escalable.
              </p>
            </div>

            <div class="final-actions">
              <a href="#cotizarForm" class="btn-primary">
                Ir al formulario
              </a>

              <a href={whatsappHref} target="_blank" rel="noopener" class="btn-ghost">
                Hablar por WhatsApp
              </a>
            </div>
          </div>
        </div>
      </section>
    </main>

    <Footer />

    <script is:inline>
      (function () {
        const form = document.getElementById("cotizarForm");
        const btn = document.getElementById("submitBtn");
        const msg = document.getElementById("formMsg");

        if (!form || !btn || !msg) return;

        const endpoint = new URL("/api/cotizar", location.origin);

        function getPayload(fd) {
          const entries = [...fd.entries()].filter(([key, value]) => {
            if (key === "archivo") return false;
            if (value instanceof File) return false;
            return true;
          });

          return Object.fromEntries(entries);
        }

        async function postJSON(url, payload) {
          const res = await fetch(url, {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify(payload),
            credentials: "same-origin",
          });

          let data = {};

          try {
            data = await res.json();
          } catch {
            data = {};
          }

          if (!res.ok || !data.ok) {
            const reason = data.error || `${res.status} ${res.statusText}`;
            throw new Error(reason);
          }

          return data;
        }

        form.addEventListener("submit", async (event) => {
          event.preventDefault();

          if (!form.reportValidity()) return;

          const fd = new FormData(form);

          const honeypot = String(fd.get("company") || "").trim();

          if (honeypot.length > 0) {
            msg.textContent =
              "¡Gracias! Recibimos tu solicitud. Te contactaremos pronto.";
            form.reset();
            return;
          }

          msg.textContent = "";
          btn.disabled = true;

          const oldLabel = btn.textContent;
          btn.textContent = "Enviando…";

          const payload = getPayload(fd);

          try {
            await postJSON(endpoint, payload);

            msg.textContent =
              "¡Gracias! Recibimos tu solicitud. Te contactaremos pronto.";
            msg.classList.remove("text-red-300");
            msg.classList.add("text-cyan-200");

            form.reset();
          } catch (err) {
            console.error("cotizar fetch error:", err);

            msg.textContent =
              "No se pudo enviar la solicitud: " +
              (err?.message || "Error inesperado");

            msg.classList.remove("text-cyan-200");
            msg.classList.add("text-red-300");
          } finally {
            btn.disabled = false;
            btn.textContent = oldLabel;
          }
        });
      })();
    </script>
  </body>
  <style>
  .measure {
    max-width: 70ch;
    line-height: 1.75;
  }

  .measure-sm {
    max-width: 72ch;
    line-height: 1.65;
  }

  .section-space {
    padding-top: 3.5rem;
    padding-bottom: 3.5rem;
  }

  @media (min-width: 640px) {
    .section-space {
      padding-top: 4.5rem;
      padding-bottom: 4.5rem;
    }
  }

  @media (min-width: 1024px) {
    .section-space {
      padding-top: 5.75rem;
      padding-bottom: 5.75rem;
    }
  }

  .section-pill {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    border-radius: 9999px;
    border: 1px solid rgba(103, 232, 249, 0.28);
    background: rgba(103, 232, 249, 0.09);
    padding: 0.38rem 0.8rem;
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: rgba(207, 250, 254, 0.94);
  }

  .section-heading {
    max-width: 52rem;
    margin-bottom: 2rem;
  }

  .section-heading h2 {
    margin-top: 1rem;
    font-size: clamp(1.55rem, 1.25vw + 1rem, 2.35rem);
    font-weight: 950;
    line-height: 1.12;
    letter-spacing: -0.04em;
    color: rgba(248, 250, 252, 0.98);
  }

  .section-heading p {
    margin-top: 0.85rem;
    max-width: 48rem;
    font-size: 1rem;
    line-height: 1.75;
    color: rgba(203, 213, 225, 0.88);
  }

  .quote-hero {
    display: grid;
    gap: 2rem;
    align-items: center;
  }

  @media (min-width: 1024px) {
    .quote-hero {
      grid-template-columns: 1.08fr 0.92fr;
      gap: 4rem;
    }
  }

  .quote-hero-copy {
    max-width: 56rem;
  }

  .quote-title {
    margin-top: 1.25rem;
    font-size: clamp(2.15rem, 3vw + 1rem, 4.15rem);
    font-weight: 950;
    line-height: 1.02;
    letter-spacing: -0.055em;
    color: rgba(248, 250, 252, 0.98);
    text-shadow: 0 18px 54px rgba(0, 0, 0, 0.34);
  }

  .quote-lead {
    margin-top: 1.25rem;
    max-width: 48rem;
    font-size: clamp(1rem, 0.2vw + 1rem, 1.16rem);
    line-height: 1.78;
    color: rgba(226, 232, 240, 0.9);
  }

  .hero-actions {
    margin-top: 1.8rem;
    display: flex;
    flex-direction: column;

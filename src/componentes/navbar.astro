---
const links = [
  { href: '/', label: 'Inicio' },
  { href: '/productos', label: 'Soluciones' },
  { href: '/nosotros', label: 'Nosotros' },
  { href: '/microweb', label: 'MicroWeb' },
];

const { pathname } = Astro.url;

const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<nav
  id="nv-navbar"
  class="fixed inset-x-0 top-0 z-50 px-3 sm:px-5 transition-all duration-300"
  aria-label="Navegación principal"
>
  <div
    id="nv-shell"
    class="
      relative mx-auto mt-3 w-full max-w-7xl overflow-hidden rounded-2xl border
      border-cyan-300/15 bg-slate-950/72 shadow-[0_18px_60px_rgba(0,0,0,0.35)]
      ring-1 ring-white/10 backdrop-blur-2xl transition-all duration-300
      before:pointer-events-none before:absolute before:inset-0
      before:bg-[radial-gradient(circle_at_12%_0%,rgba(34,211,238,0.18),transparent_30%),radial-gradient(circle_at_92%_10%,rgba(59,130,246,0.16),transparent_34%)]
      after:pointer-events-none after:absolute after:inset-0
      after:bg-[linear-gradient(rgba(255,255,255,0.035)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.035)_1px,transparent_1px)]
      after:bg-[size:34px_34px] after:opacity-[0.13]
    "
  >
    <div class="relative z-10 flex h-16 items-center justify-between px-4 sm:px-5 lg:px-6">
      <!-- Brand -->
      <a
        href="/"
        class="group inline-flex min-w-0 items-center gap-3"
        aria-label="NeoTec MX Business Solutions"
      >
        <div
          class="
            relative flex h-11 w-11 shrink-0 items-center justify-center overflow-hidden rounded-2xl
            border border-cyan-300/30 bg-cyan-300/10
            shadow-[0_0_32px_rgba(34,211,238,0.18)]
            transition duration-300 group-hover:border-cyan-200/60 group-hover:shadow-[0_0_42px_rgba(34,211,238,0.32)]
          "
        >
          <div class="absolute inset-0 bg-gradient-to-br from-cyan-300/25 via-transparent to-blue-600/25"></div>
          <div class="absolute inset-x-2 top-0 h-px bg-cyan-200/70"></div>

          <img
            src="/web-app-manifest-512x512.png"
            alt="NeoTec"
            class="relative h-10 w-10 rounded-lg object-contain"
            loading="eager"
          />
        </div>

        <div class="min-w-0 leading-tight">
          <p class="truncate text-[1.05rem] font-black tracking-wide text-white">
            NeoTec<span class="text-cyan-300">MX</span>
          </p>
          <p class="hidden text-[10px] font-semibold uppercase tracking-[0.26em] text-slate-400 sm:block">
            Business Solutions
          </p>
        </div>
      </a>

      <!-- Desktop Nav -->
      <div
        class="
          hidden items-center rounded-full border border-white/10 bg-white/[0.035]
          p-1 shadow-inner shadow-white/5 md:flex
        "
      >
        {links.map((l) => (
          <a
            href={l.href}
            class={[
              "relative rounded-full px-4 py-2 text-sm font-medium transition-all duration-200",
              "text-slate-300 hover:bg-white/7 hover:text-cyan-200",
              "focus:outline-none focus-visible:ring-2 focus-visible:ring-cyan-300/70",
              isActive(l.href)
                ? "bg-cyan-300/12 text-white shadow-[inset_0_0_0_1px_rgba(103,232,249,0.18),0_0_22px_rgba(34,211,238,0.12)] after:absolute after:inset-x-4 after:-bottom-1 after:h-[2px] after:rounded-full after:bg-cyan-300 after:shadow-[0_0_16px_rgba(34,211,238,0.85)]"
                : "",
            ].join(" ")}
          >
            {l.label}
          </a>
        ))}
      </div>

      <!-- CTA + Mobile -->
      <div class="flex items-center gap-2">
        <a
          href="/cotizar"
          class="
            group hidden items-center gap-2 rounded-full border border-cyan-200/30
            bg-cyan-300 px-5 py-2.5 text-sm font-black text-slate-950
            shadow-[0_0_28px_rgba(34,211,238,0.28)]
            transition duration-300 hover:bg-white hover:shadow-[0_0_42px_rgba(34,211,238,0.46)]
            md:inline-flex
          "
        >
          Cotizar proyecto
          <svg
            class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-0.5"
            viewBox="0 0 24 24"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M5 12h14m-6-6 6 6-6 6"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </a>

        <button
          id="nv-menu-btn"
          class="
            inline-flex h-11 w-11 items-center justify-center rounded-2xl
            border border-white/10 bg-white/[0.055] text-slate-100
            shadow-inner shadow-white/5 transition hover:border-cyan-300/30 hover:bg-cyan-300/10 hover:text-cyan-200
            focus:outline-none focus-visible:ring-2 focus-visible:ring-cyan-300/70 md:hidden
          "
          aria-label="Abrir menú"
          aria-expanded="false"
          aria-controls="nv-mobile"
          type="button"
        >
          <svg
            id="nv-icon-open"
            width="22"
            height="22"
            viewBox="0 0 24 24"
            fill="none"
            class="transition"
            aria-hidden="true"
          >
            <path
              d="M4 7h16M4 12h16M4 17h16"
              stroke="currentColor"
              stroke-width="1.9"
              stroke-linecap="round"
            />
          </svg>

          <svg
            id="nv-icon-close"
            width="22"
            height="22"
            viewBox="0 0 24 24"
            fill="none"
            class="hidden transition"
            aria-hidden="true"
          >
            <path
              d="M6 6l12 12M18 6 6 18"
              stroke="currentColor"
              stroke-width="1.9"
              stroke-linecap="round"
            />
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Sheet -->
    <div
      id="nv-mobile"
      class="relative z-10 max-h-0 overflow-hidden border-t border-white/0 transition-[max-height,border-color] duration-300 ease-out md:hidden"
    >
      <div class="space-y-2 px-4 pb-4 pt-2">
        {links.map((l) => (
          <a
            href={l.href}
            class={[
              "flex items-center justify-between rounded-2xl border px-4 py-3 text-[15px] font-semibold transition",
              "border-white/8 bg-white/[0.035] text-slate-300 hover:border-cyan-300/20 hover:bg-cyan-300/8 hover:text-cyan-200",
              isActive(l.href)
                ? "border-cyan-300/25 bg-cyan-300/12 text-white shadow-[0_0_24px_rgba(34,211,238,0.12)]"
                : "",
            ].join(" ")}
          >
            <span>{l.label}</span>

            <svg
              class="h-4 w-4 opacity-60"
              viewBox="0 0 24 24"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M9 6l6 6-6 6"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </a>
        ))}

        <a
          href="/cotizar"
          class="
            mt-3 flex items-center justify-center gap-2 rounded-2xl
            bg-cyan-300 px-4 py-3 text-[15px] font-black text-slate-950
            shadow-[0_0_34px_rgba(34,211,238,0.32)]
            transition hover:bg-white
          "
        >
          Cotizar proyecto
          <svg
            class="h-4 w-4"
            viewBox="0 0 24 24"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M5 12h14m-6-6 6 6-6 6"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </a>
      </div>
    </div>
  </div>
</nav>

<script is:inline>
  const navbar = document.getElementById('nv-navbar');
  const shell = document.getElementById('nv-shell');
  const sheet = document.getElementById('nv-mobile');
  const btn = document.getElementById('nv-menu-btn');
  const iconOpen = document.getElementById('nv-icon-open');
  const iconClose = document.getElementById('nv-icon-close');

  const onScroll = () => {
    const y = window.scrollY || document.documentElement.scrollTop;

    navbar?.classList.toggle('translate-y-[-2px]', y > 8);
    shell?.classList.toggle('bg-slate-950/88', y > 8);
    shell?.classList.toggle('border-cyan-300/25', y > 8);
    shell?.classList.toggle('shadow-[0_22px_80px_rgba(0,0,0,0.48)]', y > 8);
  };

  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  let open = false;

  const setMenu = (value) => {
    open = value;

    if (!btn || !sheet) return;

    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');

    sheet.style.maxHeight = open ? sheet.scrollHeight + 'px' : '0px';
    sheet.classList.toggle('border-white/10', open);
    sheet.classList.toggle('border-white/0', !open);

    iconOpen?.classList.toggle('hidden', open);
    iconClose?.classList.toggle('hidden', !open);
  };

  btn?.addEventListener('click', () => {
    setMenu(!open);
  });

  sheet?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setMenu(false));
  });

  window.addEventListener('resize', () => {
    if (window.innerWidth >= 768) {
      setMenu(false);
    } else if (open && sheet) {
      sheet.style.maxHeight = sheet.scrollHeight + 'px';
    }
  });
</script>
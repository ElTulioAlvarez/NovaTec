---
// AMXBackground.astro
// Fondo sobrio para AntimatterMX
// Estilo: trazos técnicos, grid sutil, atmósfera oscura
// Sin protagonismo visual; debe acompañar, no competir.

interface Props {
  opacity?: number;
  showGrid?: boolean;
  showVignette?: boolean;
}

const {
  opacity = 0.14,
  showGrid = true,
  showVignette = true,
} = Astro.props as Props;
---

<div
  aria-hidden="true"
  class="amx-bg"
  style={`--amx-bg-opacity:${opacity};`}
>
  <svg
    class="amx-bg__svg"
    viewBox="0 0 1600 900"
    width="100%"
    height="100%"
    preserveAspectRatio="xMidYMid slice"
    role="img"
  >
    <defs>
      <pattern id="amxGrid" width="88" height="88" patternUnits="userSpaceOnUse">
        <path
          d="M88 0 L0 0 0 88"
          fill="none"
          stroke="rgba(244,247,250,0.022)"
          stroke-width="1"
        />
        <path
          d="M44 0 V88 M0 44 H88"
          fill="none"
          stroke="rgba(30,136,255,0.012)"
          stroke-width="1"
        />
      </pattern>

      <pattern id="amxDots" width="40" height="40" patternUnits="userSpaceOnUse">
        <circle cx="5" cy="5" r="0.65" fill="rgba(244,247,250,0.028)" />
      </pattern>

      <radialGradient id="amxTopGlow" cx="42%" cy="0%" r="70%">
        <stop offset="0%" stop-color="rgba(30,136,255,0.075)" />
        <stop offset="45%" stop-color="rgba(10,58,94,0.035)" />
        <stop offset="100%" stop-color="rgba(0,0,0,0)" />
      </radialGradient>

      <radialGradient id="amxLeftGlow" cx="0%" cy="38%" r="65%">
        <stop offset="0%" stop-color="rgba(30,136,255,0.055)" />
        <stop offset="58%" stop-color="rgba(10,58,94,0.022)" />
        <stop offset="100%" stop-color="rgba(0,0,0,0)" />
      </radialGradient>

      <radialGradient id="amxRightGlow" cx="100%" cy="52%" r="70%">
        <stop offset="0%" stop-color="rgba(77,184,255,0.05)" />
        <stop offset="62%" stop-color="rgba(10,58,94,0.018)" />
        <stop offset="100%" stop-color="rgba(0,0,0,0)" />
      </radialGradient>

      <radialGradient id="amxVignette" cx="50%" cy="50%" r="78%">
        <stop offset="0%" stop-color="rgba(0,0,0,0.04)" />
        <stop offset="55%" stop-color="rgba(0,0,0,0.16)" />
        <stop offset="100%" stop-color="rgba(0,0,0,0.68)" />
      </radialGradient>

      <filter id="amxSoftGlow" x="-60%" y="-60%" width="220%" height="220%">
        <feGaussianBlur stdDeviation="0.9" result="blur" />
        <feMerge>
          <feMergeNode in="blur" />
          <feMergeNode in="SourceGraphic" />
        </feMerge>
      </filter>
    </defs>

    <rect width="1600" height="900" fill="#050608" />
    <rect width="1600" height="900" fill="url(#amxTopGlow)" />
    <rect width="1600" height="900" fill="url(#amxLeftGlow)" />
    <rect width="1600" height="900" fill="url(#amxRightGlow)" />

    {showGrid && (
      <>
        <rect width="1600" height="900" fill="url(#amxGrid)" opacity="0.72" />
        <rect width="1600" height="900" fill="url(#amxDots)" opacity="0.18" />
      </>
    )}

    <g opacity="var(--amx-bg-opacity)" filter="url(#amxSoftGlow)">
      <!-- Circuitos superiores discretos -->
      <path
        d="M-40 176 H180 C216 176 238 198 238 234 V284 C238 320 260 342 296 342 H460"
        fill="none"
        stroke="rgba(157,218,255,0.42)"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      />

      <path
        d="M76 706 H286 C322 706 344 684 344 648 V592 C344 556 366 534 402 534 H614"
        fill="none"
        stroke="rgba(77,184,255,0.34)"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
      />

      <path
        d="M1640 238 H1390 C1354 238 1332 260 1332 296 V344 C1332 380 1310 402 1274 402 H1120"
        fill="none"
        stroke="rgba(157,218,255,0.36)"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      />

      <path
        d="M1640 704 H1438 C1402 704 1380 682 1380 646 V574 C1380 538 1358 516 1322 516 H1184"
        fill="none"
        stroke="rgba(77,184,255,0.3)"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
      />

      <!-- Trazos centrales muy sutiles -->
      <path
        d="M606 108 V210 C606 246 628 268 664 268 H762 C798 268 820 290 820 326 V396"
        fill="none"
        stroke="rgba(157,218,255,0.24)"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"
      />

      <path
        d="M934 792 V684 C934 648 912 626 876 626 H792 C756 626 734 604 734 568 V492"
        fill="none"
        stroke="rgba(77,184,255,0.22)"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      />

      <!-- Nodos -->
      <g fill="rgba(157,218,255,0.44)" stroke="rgba(77,184,255,0.28)" stroke-width="1">
        <circle cx="238" cy="234" r="4" />
        <circle cx="344" cy="648" r="4" />
        <circle cx="1332" cy="296" r="4" />
        <circle cx="1380" cy="646" r="4" />
        <circle cx="820" cy="326" r="3.5" />
        <circle cx="734" cy="568" r="3.5" />
      </g>

      <!-- Micro componentes, sin robar atención -->
      <g opacity="0.65">
        <g stroke="rgba(167,176,188,0.26)" stroke-width="1.4" stroke-linecap="round">
          <path d="M126 118 H226" />
          <path d="M126 138 H270" />
          <path d="M126 158 H236" />

          <path d="M1338 770 H1468" />
          <path d="M1378 790 H1512" />
          <path d="M1312 810 H1428" />
        </g>

        <g fill="rgba(167,176,188,0.24)">
          <rect x="96" y="111" width="16" height="12" rx="2" />
          <rect x="96" y="131" width="16" height="12" rx="2" />
          <rect x="96" y="151" width="16" height="12" rx="2" />

          <rect x="1484" y="763" width="16" height="12" rx="2" />
          <rect x="1528" y="783" width="16" height="12" rx="2" />
          <rect x="1444" y="803" width="16" height="12" rx="2" />
        </g>
      </g>

      <!-- Anillos técnicos AMX, muy leves -->
      <g opacity="0.42" fill="none">
        <circle
          cx="1252"
          cy="244"
          r="116"
          stroke="rgba(30,136,255,0.16)"
          stroke-width="1"
        />
        <circle
          cx="1252"
          cy="244"
          r="72"
          stroke="rgba(157,218,255,0.12)"
          stroke-width="1"
          stroke-dasharray="4 8"
        />

        <circle
          cx="326"
          cy="666"
          r="132"
          stroke="rgba(30,136,255,0.13)"
          stroke-width="1"
        />
        <circle
          cx="326"
          cy="666"
          r="82"
          stroke="rgba(157,218,255,0.1)"
          stroke-width="1"
          stroke-dasharray="4 8"
        />
      </g>
    </g>

    <rect width="1600" height="900" fill="rgba(0,0,0,0.32)" />

    {showVignette && <rect width="1600" height="900" fill="url(#amxVignette)" />}
  </svg>
</div>

<style>
  .amx-bg {
    position: fixed;
    inset: 0;
    z-index: -3;
    overflow: hidden;
    background:
      radial-gradient(circle at 44% 0%, rgba(30, 136, 255, 0.065), transparent 42%),
      #050608;
    pointer-events: none;
    contain: strict;
  }

  .amx-bg__svg {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }

  @media (max-width: 1024px) {
    .amx-bg {
      opacity: 0.86;
    }
  }

  @media (max-width: 768px) {
    .amx-bg {
      opacity: 0.76;
    }
  }

  @media (max-width: 480px) {
    .amx-bg {
      opacity: 0.64;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .amx-bg * {
      animation: none !important;
    }
  }
</style>
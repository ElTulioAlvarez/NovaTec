---
export interface Props {
  logoSrc?: string;
}

const { logoSrc = "/web-app-manifest-512x512.png" } = Astro.props;
const year = new Date().getFullYear();

const navLinks = [
  { href: "/", label: "Inicio" },
  { href: "/productos", label: "Soluciones" },
  { href: "/nosotros", label: "Nosotros" },
  { href: "/microweb", label: "MicroWeb" },
  { href: "/cotizar", label: "Cotizar" },
];

const serviceLinks = [
  { href: "/productos", label: "NeoTec POS" },
  { href: "/microweb", label: "MicroWebs" },
  { href: "/productos", label: "Software a medida" },
  { href: "/productos", label: "Social Media" },
];

const legalLinks = [
  { href: "/terminos", label: "Términos" },
  { href: "/privacidad", label: "Privacidad" },
  { href: "/aviso", label: "Aviso de privacidad" },
];
---

<footer class="nt-footer relative mt-20 w-full overflow-hidden text-slate-200">
  <!-- Background FX -->
  <div class="pointer-events-none absolute inset-0 -z-10 bg-slate-950"></div>
  <div class="nt-footer-glow pointer-events-none absolute inset-0 -z-10"></div>
  <div class="nt-footer-grid pointer-events-none absolute inset-0 -z-10"></div>

  <!-- Top line -->
  <div class="mx-auto h-px w-[92%] max-w-7xl bg-gradient-to-r from-transparent via-cyan-300/50 to-transparent"></div>

  <section class="relative z-10 mx-auto w-full max-w-7xl px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
    <!-- Main Footer Card -->
    <div class="nt-shell overflow-hidden rounded-[1.6rem] border border-cyan-300/15 bg-slate-950/70 shadow-[0_24px_90px_rgba(0,0,0,0.45)] backdrop-blur-2xl">
      <!-- Brand / CTA Strip -->
      <div class="relative overflow-hidden border-b border-white/10 px-5 py-7 sm:px-8 lg:px-10">
        <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_14%_0%,rgba(34,211,238,0.18),transparent_32%),radial-gradient(circle_at_92%_10%,rgba(59,130,246,0.14),transparent_35%)]"></div>

        <div class="relative flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">
          <a href="/" class="group inline-flex items-center gap-4" aria-label="NeoTec MX Business Solutions">
            <div class="relative flex h-14 w-14 shrink-0 items-center justify-center overflow-hidden rounded-2xl border border-cyan-300/30 bg-cyan-300/10 shadow-[0_0_36px_rgba(34,211,238,0.18)] transition group-hover:border-cyan-200/60 group-hover:shadow-[0_0_46px_rgba(34,211,238,0.32)]">
              <div class="absolute inset-0 bg-gradient-to-br from-cyan-300/25 via-transparent to-blue-600/25"></div>
              <div class="absolute inset-x-3 top-0 h-px bg-cyan-200/70"></div>
              <img
                src={logoSrc}
                alt="NeoTec"
                class="relative h-9 w-9 rounded-xl object-contain"
                loading="lazy"
                decoding="async"
              />
            </div>

            <div class="leading-tight">
              <p class="text-xl font-black tracking-wide text-white sm:text-2xl">
                NeoTec<span class="text-cyan-300">MX</span>
              </p>
              <p class="mt-1 text-[11px] font-semibold uppercase tracking-[0.28em] text-slate-400">
                Business Solutions
              </p>
            </div>
          </a>

          <div class="max-w-2xl lg:text-right">
            <p class="text-sm font-medium leading-7 text-slate-300 sm:text-base">
              Creamos soluciones digitales para negocios que quieren vender mejor, operar con más control
              y dejar de administrar todo “a pura fe y Excel bendecido”.
            </p>

            <div class="mt-5 flex flex-col gap-3 sm:flex-row lg:justify-end">
              <a
                href="/cotizar"
                class="inline-flex items-center justify-center gap-2 rounded-full bg-cyan-300 px-5 py-3 text-sm font-black text-slate-950 shadow-[0_0_34px_rgba(34,211,238,0.32)] transition hover:bg-white hover:shadow-[0_0_48px_rgba(34,211,238,0.46)]"
              >
                Cotizar proyecto
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>

              <a
                href="https://wa.me/524433711589"
                target="_blank"
                rel="noopener"
                class="inline-flex items-center justify-center gap-2 rounded-full border border-white/10 bg-white/[0.045] px-5 py-3 text-sm font-bold text-slate-100 transition hover:border-cyan-300/30 hover:bg-cyan-300/10 hover:text-cyan-200"
              >
                WhatsApp
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M7 17 17 7M9 7h8v8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Footer Content -->
      <div class="grid grid-cols-1 gap-0 lg:grid-cols-12">
        <!-- About -->
        <div class="border-b border-white/10 p-5 sm:p-8 lg:col-span-4 lg:border-b-0 lg:border-r">
          <h2 class="text-sm font-bold uppercase tracking-[0.22em] text-cyan-200">
            Qué hacemos
          </h2>

          <p class="mt-4 text-sm leading-7 text-slate-300">
            Desarrollamos software, puntos de venta, páginas web, microwebs y estrategias digitales
            para pequeñas y medianas empresas que necesitan tecnología útil, medible y bien implementada.
          </p>

          <div class="mt-6 grid grid-cols-2 gap-3">
            <div class="nt-mini-card">
              <span class="text-lg font-black text-white">POS</span>
              <span class="text-xs text-slate-400">Control comercial</span>
            </div>

            <div class="nt-mini-card">
              <span class="text-lg font-black text-white">Web</span>
              <span class="text-xs text-slate-400">Presencia digital</span>
            </div>

            <div class="nt-mini-card">
              <span class="text-lg font-black text-white">Apps</span>
              <span class="text-xs text-slate-400">Software a medida</span>
            </div>

            <div class="nt-mini-card">
              <span class="text-lg font-black text-white">Media</span>
              <span class="text-xs text-slate-400">Marca y demanda</span>
            </div>
          </div>
        </div>

        <!-- Navigation -->
        <nav class="border-b border-white/10 p-5 sm:p-8 lg:col-span-2 lg:border-b-0 lg:border-r" aria-label="Footer navegación">
          <h2 class="text-sm font-bold uppercase tracking-[0.22em] text-cyan-200">
            Explorar
          </h2>

          <ul class="mt-4 space-y-3 text-sm">
            {navLinks.map((link) => (
              <li>
                <a href={link.href} class="nt-link">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>

        <!-- Services -->
        <nav class="border-b border-white/10 p-5 sm:p-8 lg:col-span-3 lg:border-b-0 lg:border-r" aria-label="Footer soluciones">
          <h2 class="text-sm font-bold uppercase tracking-[0.22em] text-cyan-200">
            Soluciones
          </h2>

          <ul class="mt-4 space-y-3 text-sm">
            {serviceLinks.map((link) => (
              <li>
                <a href={link.href} class="nt-link">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>

          <div class="mt-6 rounded-2xl border border-cyan-300/15 bg-cyan-300/[0.06] p-4">
            <p class="text-xs font-bold uppercase tracking-[0.2em] text-cyan-200">
              Próximamente
            </p>
            <p class="mt-2 text-sm leading-6 text-slate-300">
              neotecmx.com como dominio oficial de marca.
            </p>
          </div>
        </nav>

        <!-- Contact -->
        <div class="p-5 sm:p-8 lg:col-span-3">
          <h2 class="text-sm font-bold uppercase tracking-[0.22em] text-cyan-200">
            Contacto
          </h2>

          <ul class="mt-4 space-y-4 text-sm text-slate-300">
            <li>
              <span class="block text-xs uppercase tracking-[0.18em] text-slate-500">Email</span>
              <a href="mailto:noe.hdz@neotecmx.com" class="nt-link break-all">
                noe.hdz@neotecmx.com
              </a>
            </li>
            <li>
              <a href="mailto:malvarez@neotecmx.com" class="nt-link break-all">
                malvarez@neotecmx.com
              </a>
            </li>

            <li>
              <span class="block text-xs uppercase tracking-[0.18em] text-slate-500">WhatsApp</span>
              <a href="https://wa.me/524433711589" target="_blank" rel="noopener" class="nt-link">
                +52 443 371 1589
              </a>
            </li>

            <li>
              <span class="block text-xs uppercase tracking-[0.18em] text-slate-500">Ubicación</span>
              <span>Morelia, Michoacán — México</span>
            </li>
          </ul>

          <div class="mt-6 flex items-center gap-3">
            <a href="https://www.facebook.com/profile.php?id=61582367339114" target="_blank" rel="noopener" class="nt-social" aria-label="Facebook">
              <span aria-hidden="true">f</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Map -->
      <div class="border-t border-white/10 p-5 sm:p-8">
        <div class="grid grid-cols-1 gap-5 lg:grid-cols-12 lg:items-center">
          <div class="lg:col-span-4">
            <p class="text-sm font-bold uppercase tracking-[0.22em] text-cyan-200">
              Base operativa
            </p>
            <h3 class="mt-3 text-2xl font-black text-white">
              Morelia, Michoacán
            </h3>
            <p class="mt-3 text-sm leading-7 text-slate-300">
              Atendemos proyectos locales y remotos para negocios que quieren digitalizar su operación,
              mejorar su imagen y construir sistemas que realmente trabajen.
            </p>
          </div>

          <div class="lg:col-span-8">
            <div class="overflow-hidden rounded-3xl border border-cyan-300/15 bg-white/[0.035] p-1 shadow-[0_18px_60px_rgba(0,0,0,0.35)]">
              <iframe
                title="Morelia, Michoacán — Mapa"
                loading="lazy"
                class="block aspect-[16/9] w-full rounded-[1.3rem] grayscale-[0.15] invert-0"
                src="https://www.openstreetmap.org/export/embed.html?bbox=-101.235%2C19.675%2C-101.160%2C19.735&layer=mapnik&marker=19.705%2C-101.194">
              </iframe>
            </div>
          </div>
        </div>
      </div>

      <!-- Legal -->
      <div class="flex flex-col gap-4 border-t border-white/10 px-5 py-5 text-xs text-slate-400 sm:px-8 lg:flex-row lg:items-center lg:justify-between">
        <p>
          © {year} NeoTec Business Solutions. Todos los derechos reservados.
        </p>

        <ul class="flex flex-wrap items-center gap-x-5 gap-y-2">
          {legalLinks.map((link) => (
            <li>
              <a href={link.href} class="nt-link text-xs">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>
</footer>

<style>
  @property --nt-angle {
    syntax: "<angle>";
    initial-value: 0deg;
    inherits: false;
  }

  @keyframes nt-spin {
    from {
      --nt-angle: 0deg;
    }
    to {
      --nt-angle: 360deg;
    }
  }

  .nt-footer {
    isolation: isolate;
  }

  .nt-footer-glow {
    background:
      radial-gradient(circle at 15% 10%, rgba(34, 211, 238, 0.18), transparent 34rem),
      radial-gradient(circle at 85% 20%, rgba(37, 99, 235, 0.16), transparent 32rem),
      radial-gradient(circle at 50% 100%, rgba(14, 165, 233, 0.10), transparent 34rem);
    filter: blur(18px);
  }

  .nt-footer-grid {
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.035) 1px, transparent 1px);
    background-size: 36px 36px;
    mask-image: linear-gradient(to bottom, transparent, black 12%, black 88%, transparent);
    opacity: 0.28;
  }

  .nt-shell {
    position: relative;
  }

  .nt-shell::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1px;
    background: conic-gradient(
      from var(--nt-angle),
      rgba(34, 211, 238, 0.65),
      rgba(37, 99, 235, 0.35),
      rgba(14, 165, 233, 0.55),
      rgba(255, 255, 255, 0.16),
      rgba(34, 211, 238, 0.65)
    );
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
    opacity: 0.55;
    animation: nt-spin 24s linear infinite;
  }

  .nt-mini-card {
    display: flex;
    min-height: 5.2rem;
    flex-direction: column;
    justify-content: center;
    gap: 0.25rem;
    border-radius: 1rem;
    border: 1px solid rgba(103, 232, 249, 0.14);
    background:
      radial-gradient(circle at top left, rgba(34, 211, 238, 0.12), transparent 55%),
      rgba(255, 255, 255, 0.035);
    padding: 1rem;
    box-shadow: inset 0 0 0 1px rgba(255,255,255,0.035);
  }

  .nt-link {
    color: rgba(203, 213, 225, 0.94);
    text-decoration: none;
    transition:
      color 0.2s ease,
      text-shadow 0.2s ease,
      transform 0.2s ease;
  }

  .nt-link:hover {
    color: rgb(165, 243, 252);
    text-shadow: 0 0 16px rgba(34, 211, 238, 0.45);
  }

  .nt-social {
    display: inline-flex;
    height: 2.35rem;
    width: 2.35rem;
    align-items: center;
    justify-content: center;
    border-radius: 0.9rem;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background:
      radial-gradient(circle at top left, rgba(34, 211, 238, 0.15), transparent 55%),
      rgba(255, 255, 255, 0.045);
    color: rgba(241, 245, 249, 0.95);
    font-weight: 800;
    box-shadow:
      inset 0 0 0 1px rgba(255,255,255,0.045),
      0 10px 30px rgba(0,0,0,0.24);
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      background 0.2s ease,
      color 0.2s ease;
  }

  .nt-social:hover {
    transform: translateY(-2px);
    border-color: rgba(103, 232, 249, 0.35);
    background: rgba(34, 211, 238, 0.11);
    color: rgb(165, 243, 252);
  }

  @media (prefers-reduced-motion: reduce) {
    .nt-shell::before {
      animation: none;
    }

    .nt-social,
    .nt-link {
      transition: none;
    }
  }
</style>